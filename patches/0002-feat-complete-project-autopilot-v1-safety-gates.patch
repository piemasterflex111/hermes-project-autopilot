+@contextlib.contextmanager
+def _trusted_mission_controller_mutation():
+    """Allow structural changes to mission cards in controller code only.
+
+    Mission task cards are a materialized execution contract.  Ordinary
+    Kanban clients may advance their worker lifecycle through the dedicated
+    complete/block/heartbeat paths, but must not rewrite the card or graph
+    underneath the mission controller.  The controller uses this narrow,
+    process-local capability while it is first materializing the accepted
+    plan (and for its own start latch).
+    """
+    token: Token[bool] = _MISSION_CONTROLLER_MUTATION.set(True)
+    try:
+        yield
+    finally:
+        _MISSION_CONTROLLER_MUTATION.reset(token)
+
+
+def assert_task_mutation_allowed(
+    conn: sqlite3.Connection,
+    *task_ids: str,
+    operation: str = "mutate",
+) -> None:
+    """Fail closed when a generic mutator targets a mission-linked card."""
+    ids = tuple(dict.fromkeys(task_id for task_id in task_ids if task_id))
+    if not ids or _MISSION_CONTROLLER_MUTATION.get():
+        return
+    placeholders = ",".join("?" for _ in ids)
+    rows = conn.execute(
+        f"""SELECT t.id,
+                   COALESCE(t.mission_id, mc.mission_id) AS mission_id
+              FROM tasks t
+              LEFT JOIN mission_task_manifest_cards mc ON mc.task_id=t.id
+             WHERE t.id IN ({placeholders})
+               AND COALESCE(t.mission_id, mc.mission_id) IS NOT NULL""",
+        ids,
+    ).fetchall()
+    if rows:
+        bound = ", ".join(
+            f"{row['id']} ({row['mission_id']})" for row in rows
+        )
+        raise PermissionError(
+            f"cannot {operation} mission-linked task card(s): {bound}; "
+            "use the mission controller"
+        )
+
