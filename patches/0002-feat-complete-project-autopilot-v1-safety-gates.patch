+def get_task_manifest(
+    conn: sqlite3.Connection, mission_id: str,
+) -> Optional[dict[str, Any]]:
+    """Return the immutable materialized-card manifest, if accepted."""
+    ensure_schema(conn)
+    row = conn.execute(
+        "SELECT * FROM mission_task_manifests WHERE mission_id=?",
+        (mission_id,),
+    ).fetchone()
