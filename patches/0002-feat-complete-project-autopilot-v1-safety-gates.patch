+def _mountinfo_indicates_container(mountinfo: str) -> bool:
+    """Inspect only process-root/cgroup mounts, not unrelated child mounts."""
+    markers = ("kubepods", "containerd", "crio")
+    for line in mountinfo.splitlines():
+        fields = line.split()
+        if len(fields) < 10 or "-" not in fields:
+            continue
+        separator = fields.index("-")
+        if separator + 2 >= len(fields):
+            continue
+        root = fields[3]
+        mount_point = fields[4]
+        fs_type = fields[separator + 1]
+        source = fields[separator + 2]
+        if mount_point == "/" and (
+            fs_type in {"overlay", "fuse-overlayfs"}
+            or any(marker in value for marker in markers for value in (root, source, line))
+        ):
+            return True
+        if mount_point == "/sys/fs/cgroup" and any(
+            marker in value for marker in markers for value in (root, source)
+        ):
+            return True
+    return False
+
