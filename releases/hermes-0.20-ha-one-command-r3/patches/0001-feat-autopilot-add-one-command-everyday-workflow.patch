+def test_resolve_repository_scopes_to_current_subdirectory(tmp_path: Path) -> None:
+    repo = init_repo(tmp_path)
+    root, invocation, prefix = ap._resolve_repository(repo / "nested")
+    assert root == repo.resolve()
+    assert invocation == (repo / "nested").resolve()
+    assert prefix == "nested"
+
+
+def test_verification_and_allowed_paths_are_scoped() -> None:
+    assert ap._scoped_command("nested", "test -f result.txt") == (
+        "cd nested && test -f result.txt"
+    )
+    assert ap._allowed_paths("nested", []) == ["nested"]
+    assert ap._allowed_paths("nested", ["docs/out.md"]) == ["nested/docs/out.md"]
+    with pytest.raises(ap.AutopilotError):
+        ap._allowed_paths("nested", ["../outside"])
