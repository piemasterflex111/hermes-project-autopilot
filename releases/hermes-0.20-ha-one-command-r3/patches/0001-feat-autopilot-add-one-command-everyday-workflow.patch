+def test_parser_accepts_single_command_shape() -> None:
+    parser = argparse.ArgumentParser()
+    sub = parser.add_subparsers(dest="command")
+    ap.build_parser(sub)
+    args = parser.parse_args([
+        "autopilot",
+        "Create a file",
+    ])
+    assert args.objective == "Create a file"
+    assert args.verify == []
+    assert args.repo == "."
+
+
