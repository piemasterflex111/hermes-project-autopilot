+def test_default_verification_requires_valid_nonempty_diff() -> None:
+    assert ap._verification_commands("", []) == [
+        'git diff --check && test -n "$(git status --porcelain)"'
+    ]
+    assert ap._verification_commands("nested", []) == [
+        'git diff --check && test -n "$(git status --porcelain -- nested)"'
+    ]
+    assert ap._verification_commands("nested", ["test -f result.txt"]) == [
+        "cd nested && test -f result.txt"
+    ]
