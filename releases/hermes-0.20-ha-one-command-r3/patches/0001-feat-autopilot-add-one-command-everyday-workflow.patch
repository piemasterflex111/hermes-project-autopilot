+def test_dirty_repository_uses_clean_shadow(tmp_path: Path, monkeypatch) -> None:
+    repo = init_repo(tmp_path)
+    (repo / "dirty.txt").write_text("local\n", encoding="utf-8")
+    monkeypatch.setattr(ap.Path, "home", classmethod(lambda cls: tmp_path / "home"))
+    context = ap._prepare_repository(repo / "nested")
+    try:
+        assert context.dirty is True
+        assert context.shadow_path is not None
+        assert context.source_repo != repo
+        assert git(context.source_repo, "status", "--porcelain") == ""
+        assert context.scope_prefix == "nested"
+    finally:
+        ap._cleanup_shadow(context)
+
+
+def test_clean_repository_uses_original_root(tmp_path: Path) -> None:
+    repo = init_repo(tmp_path)
+    context = ap._prepare_repository(repo / "nested")
+    assert context.dirty is False
+    assert context.shadow_path is None
+    assert context.source_repo == repo.resolve()
+
