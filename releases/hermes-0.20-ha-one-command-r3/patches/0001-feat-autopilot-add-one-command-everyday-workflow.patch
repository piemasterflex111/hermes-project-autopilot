+def test_apply_verified_change_updates_only_verified_paths(tmp_path: Path, monkeypatch) -> None:
+    repo = init_repo(tmp_path)
+    base = git(repo, "rev-parse", "HEAD")
+    git(repo, "switch", "-c", "mission")
+    (repo / "nested" / "result.txt").write_text("done\n", encoding="utf-8")
+    git(repo, "add", "nested/result.txt")
+    git(repo, "commit", "-m", "mission result")
+    verified = git(repo, "rev-parse", "HEAD")
+    git(repo, "switch", "main")
+    monkeypatch.setattr(ap.Path, "home", classmethod(lambda cls: tmp_path / "home"))
+    context = ap.RepositoryContext(
+        original_root=repo.resolve(),
+        invocation_dir=(repo / "nested").resolve(),
+        scope_prefix="nested",
+        source_repo=repo.resolve(),
+        shadow_path=None,
+        dirty=False,
+    )
+    result = ap._apply_verified_change(
+        context,
+        mission_id="m_test",
+        base_commit=base,
+        verified_commit=verified,
+        apply=True,
+    )
+    assert result.applied is True
+    assert result.changed_paths == ("nested/result.txt",)
+    assert (repo / "nested" / "result.txt").read_text() == "done\n"
+    assert git(repo, "status", "--porcelain", "--", "README.md") == ""
+
+
+def test_apply_verified_change_refuses_overlapping_local_edit(tmp_path: Path, monkeypatch) -> None:
+    repo = init_repo(tmp_path)
+    base = git(repo, "rev-parse", "HEAD")
+    git(repo, "switch", "-c", "mission")
+    target = repo / "nested" / "tracked.txt"
+    target.write_text("mission\n", encoding="utf-8")
+    git(repo, "add", "nested/tracked.txt")
+    git(repo, "commit", "-m", "mission edit")
+    verified = git(repo, "rev-parse", "HEAD")
+    git(repo, "switch", "main")
+    target.write_text("user edit\n", encoding="utf-8")
+    monkeypatch.setattr(ap.Path, "home", classmethod(lambda cls: tmp_path / "home"))
+    context = ap.RepositoryContext(
+        original_root=repo.resolve(),
+        invocation_dir=(repo / "nested").resolve(),
+        scope_prefix="nested",
+        source_repo=repo.resolve(),
+        shadow_path=None,
+        dirty=True,
+    )
+    result = ap._apply_verified_change(
+        context,
+        mission_id="m_conflict",
+        base_commit=base,
+        verified_commit=verified,
+        apply=True,
+    )
+    assert result.applied is False
+    assert result.conflict_paths == ("nested/tracked.txt",)
+    assert target.read_text() == "user edit\n"
+    assert result.patch_path is not None and result.patch_path.is_file()
+
+def test_task_body_pins_existing_repository_root() -> None:
+    body = ap._task_body("Create result.txt", "nested")
+    assert "existing repository root is /workspace" in body
+    assert "Do not run any git command" in body
+    assert "Never run git init" in body
+    assert "controller owns Git inspection" in body
+    assert "Target folder: /workspace/nested" in body
