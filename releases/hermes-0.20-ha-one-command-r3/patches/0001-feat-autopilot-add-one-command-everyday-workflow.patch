@@ -0,0 +1,570 @@
+"""One-command everyday interface for Project Autopilot.
+
+This module deliberately uses the proven manual-plan path underneath:
+create -> task-add -> plan-finish -> start -> dispatch -> verify -> local commit.
+The user supplies one objective and one or more deterministic verification
+commands; project registration, clean-source preparation, mission graph
+construction, polling, and safe result application are automatic.
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import hashlib
+import json
+import os
+import re
+import shlex
+import subprocess
+import sys
+import time
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Iterable, Optional
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import mission_service as mission_service
+from hermes_cli import missions_db as mdb
+from hermes_cli import projects_db as pdb
+
+
+_TERMINAL_STATUSES = {"succeeded", "blocked", "failed", "cancelled"}
+_SAFE_SEGMENT = re.compile(r"[^a-zA-Z0-9._-]+")
+
+
+class AutopilotError(RuntimeError):
+    """User-facing one-command workflow error."""
+
+
+@dataclass(frozen=True)
+class RepositoryContext:
+    original_root: Path
+    invocation_dir: Path
+    scope_prefix: str
+    source_repo: Path
+    shadow_path: Optional[Path]
+    dirty: bool
+
+
+@dataclass(frozen=True)
+class ApplyResult:
+    applied: bool
+    patch_path: Optional[Path]
+    changed_paths: tuple[str, ...]
+    conflict_paths: tuple[str, ...] = ()
+    reason: str = ""
+
+
+def build_parser(parent_subparsers) -> argparse.ArgumentParser:
+    parser = parent_subparsers.add_parser(
+        "autopilot",
+        help="Complete one verified repository task with one command",
+        description=(
+            "Run one bounded task from the current folder. Hermes automatically "
+            "detects the Git root, creates a clean shadow when the repository is "
+            "dirty, registers the project, builds and dispatches the mission, "
+            "waits for independent verification, and safely applies the verified "
+            "change back when it does not overlap local edits."
+        ),
+    )
+    parser.add_argument("objective", help="Plain-English task to complete")
+    parser.add_argument(
+        "--verify",
+        action="append",
+        default=[],
+        help=(
+            "Optional deterministic proof command. Repeat for multiple commands. "
+            "When omitted, Hermes requires a clean diff plus at least one change."
+        ),
+    )
+    parser.add_argument(
+        "--outcome",
+        default=None,
+        help="Exact desired result; defaults to the objective",
+    )
+    parser.add_argument(
+        "--repo",
+        default=".",
+        help="Folder to operate on; defaults to the current directory",
+    )
+    parser.add_argument(
+        "--path",
+        action="append",
+        default=[],
+        help=(
+            "Allowed path relative to the selected folder. Repeat as needed. "
+            "When omitted, the selected folder itself is the scope."
+        ),
+    )
+    parser.add_argument("--profile", default="default")
+    parser.add_argument("--board", default=None)
+    parser.add_argument("--timeout", type=int, default=600)
+    parser.add_argument("--poll", type=float, default=3.0)
+    parser.add_argument(
+        "--no-apply",
+        action="store_true",
+        help="Keep the verified result only on the mission branch",
+    )
+    parser.add_argument("--json", action="store_true")
+    parser.set_defaults(_autopilot_parser=parser)
+    return parser
+
+
+def _git(repo: Path, *args: str, check: bool = True, binary: bool = False):
+    proc = subprocess.run(
+        ["git", "-C", str(repo), *args],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=not binary,
+        check=False,
+    )
+    if check and proc.returncode != 0:
+        stderr = proc.stderr.decode(errors="replace") if binary else proc.stderr
+        raise AutopilotError(stderr.strip() or f"git {' '.join(args)} failed")
+    return proc
+
+
+def _safe_slug(value: str) -> str:
+    slug = _SAFE_SEGMENT.sub("-", value.strip()).strip("-._").lower()
+    return slug[:48] or "task"
+
+
+def _resolve_repository(start: str | Path) -> tuple[Path, Path, str]:
+    invocation = Path(start).expanduser().resolve()
+    if invocation.is_file():
+        invocation = invocation.parent
+    if not invocation.is_dir():
+        raise AutopilotError(f"folder does not exist: {invocation}")
+    proc = _git(invocation, "rev-parse", "--show-toplevel", check=False)
+    if proc.returncode != 0:
+        raise AutopilotError(
+            "Autopilot needs a Git repository. Run it from a project folder "
+            "that already contains Git history."
+        )
+    root = Path(proc.stdout.strip()).resolve()
+    try:
+        relative = invocation.relative_to(root)
+    except ValueError as exc:
+        raise AutopilotError("selected folder is outside its Git root") from exc
+    prefix = "" if relative == Path(".") else relative.as_posix().strip("/")
+    return root, invocation, prefix
+
+
+def _repo_dirty(repo: Path) -> bool:
+    return bool(_git(repo, "status", "--porcelain", "-z").stdout)
+
+
+def _shadow_base(original_root: Path) -> Path:
+    digest = hashlib.sha256(str(original_root).encode()).hexdigest()[:12]
+    return Path.home() / ".hermes" / "autopilot" / "shadows" / (
+        f"{_safe_slug(original_root.name)}-{digest}"
+    )
+
+
+def _create_shadow(original_root: Path) -> Path:
+    base = _shadow_base(original_root)
+    base.mkdir(parents=True, exist_ok=True)
+    shadow = base / f"run-{int(time.time())}-{os.getpid()}"
+    _git(original_root, "worktree", "add", "--detach", str(shadow), "HEAD")
+    return shadow.resolve()
+
+
+def _prepare_repository(start: str | Path) -> RepositoryContext:
+    root, invocation, prefix = _resolve_repository(start)
+    dirty = _repo_dirty(root)
+    shadow = _create_shadow(root) if dirty else None
+    return RepositoryContext(
+        original_root=root,
+        invocation_dir=invocation,
+        scope_prefix=prefix,
+        source_repo=shadow or root,
+        shadow_path=shadow,
+        dirty=dirty,
+    )
+
+
+def _cleanup_shadow(context: RepositoryContext) -> None:
+    if context.shadow_path is None:
+        return
+    with contextlib.suppress(Exception):
+        _git(
+            context.original_root,
+            "worktree",
+            "remove",
+            "--force",
+            str(context.shadow_path),
+        )
+
+
+def _join_scope(prefix: str, value: str) -> str:
+    raw = str(value or "").strip().replace("\\", "/")
+    if not raw:
+        raise AutopilotError("allowed path must not be empty")
+    candidate = Path(raw)
+    if candidate.is_absolute() or ".." in candidate.parts:
+        raise AutopilotError(f"allowed path must stay inside the selected folder: {value}")
+    normalized = candidate.as_posix().strip("/")
+    return f"{prefix}/{normalized}".strip("/") if prefix else normalized
+
+
+def _allowed_paths(prefix: str, paths: Iterable[str]) -> list[str]:
+    values = [_join_scope(prefix, item) for item in paths]
+    if values:
+        return list(dict.fromkeys(values))
+    return [prefix] if prefix else []
+
+
+def _scoped_command(prefix: str, command: str) -> str:
+    command = str(command or "").strip()
+    if not command:
+        raise AutopilotError("verification command must not be empty")
+    if not prefix:
+        return command
+    return f"cd {shlex.quote(prefix)} && {command}"
+
+
+def _verification_commands(prefix: str, commands: Iterable[str]) -> list[str]:
+    explicit = [str(item).strip() for item in commands if str(item).strip()]
+    if explicit:
+        return [_scoped_command(prefix, command) for command in explicit]
+    if prefix:
+        quoted = shlex.quote(prefix)
+        return [
+            f'git diff --check && test -n "$(git status --porcelain -- {quoted})"'
+        ]
+    return ['git diff --check && test -n "$(git status --porcelain)"']
+
+
+def _task_body(objective: str, prefix: str) -> str:
+    target = f"/workspace/{prefix}" if prefix else "/workspace"
+    return (
+        f"Complete this objective: {objective.strip()}\n\n"
+        f"Target folder: {target}\n"
+        "The existing repository root is /workspace. Begin terminal work with "
+        "cd /workspace, then edit the target folder from that root. Do not run "
+        "any git command: the host controller owns Git inspection, verification, "
+        "and commit. Never run git init, git clone, git worktree, or uv init. "
+        "Use normal terminal and file tools. Perform the requested file change "
+        "before any optional inspection. Make the smallest complete change that "
+        "satisfies the objective. Do not create another repository or write "
+        "outside /workspace. When finished, report the exact files changed."
+    )
+
+
+def _ensure_project(context: RepositoryContext, board: str) -> str:
+    digest = hashlib.sha256(str(context.original_root).encode()).hexdigest()[:8]
+    slug = f"autopilot-{_safe_slug(context.original_root.name)}-{digest}"
+    shadow_parent = _shadow_base(context.original_root)
+    shadow_parent.mkdir(parents=True, exist_ok=True)
+    with pdb.connect_closing() as conn:
+        project = pdb.get_project(conn, slug)
+        if project is None:
+            pid = pdb.create_project(
+                conn,
+                name=f"Autopilot: {context.original_root.name}",
+                slug=slug,
+                folders=[str(context.original_root), str(shadow_parent)],
+                primary_path=str(context.original_root),
+                board_slug=board,
+                description="Automatically managed by `hermes autopilot`.",
+            )
+            return pid
+        pdb.add_folder(conn, project.id, str(context.original_root))
+        pdb.add_folder(conn, project.id, str(shadow_parent))
+        if project.board_slug != board:
+            pdb.update_project(conn, project.id, board_slug=board)
+        return project.id
+
+
+def _dispatch_once(board: str, profile: str) -> None:
+    with kb.connect_closing(board=board) as conn:
+        kb.dispatch_once(
+            conn,
+            dry_run=False,
+            max_spawn=1,
+            board=board,
+            default_assignee=profile,
+        )
+
+
+def _wait_for_mission(
+    board: str,
+    mission_id: str,
+    *,
+    profile: str,
+    timeout: int,
+    poll: float,
+    quiet: bool,
+) -> dict:
+    deadline = time.monotonic() + max(1, int(timeout))
+    last_summary = ""
+    while time.monotonic() < deadline:
+        _dispatch_once(board, profile)
+        with kb.connect_closing(board=board) as conn:
+            report = mission_service.mission_report(conn, mission_id)
+        mission = report["mission"]
+        tasks = ", ".join(
+            f"{item['mission_role']}={item['status']}" for item in report["tasks"]
+        )
+        summary = f"{mission['status']} ({tasks})"
+        if not quiet and summary != last_summary:
+            print(f"  {summary}", flush=True)
+            last_summary = summary
+        if mission["status"] in _TERMINAL_STATUSES:
+            return report
+        time.sleep(max(0.25, float(poll)))
+    raise AutopilotError(
+        f"mission {mission_id} is still running after {timeout} seconds; "
+        f"check it with `hermes mission --board {board} show {mission_id}`"
+    )
+
+
+def _write_patch(
+    original_root: Path,
+    *,
+    mission_id: str,
+    base_commit: str,
+    verified_commit: str,
+) -> tuple[Path, tuple[str, ...]]:
+    result_root = Path.home() / ".hermes" / "autopilot" / "results" / mission_id
+    result_root.mkdir(parents=True, exist_ok=True)
+    patch_path = result_root / "verified.patch"
+    patch = _git(
+        original_root,
+        "diff",
+        "--binary",
+        base_commit,
+        verified_commit,
+        binary=True,
+    ).stdout
+    patch_path.write_bytes(patch)
+    raw_paths = _git(
+        original_root,
+        "diff",
+        "--name-only",
+        "-z",
+        base_commit,
+        verified_commit,
+        binary=True,
+    ).stdout
+    paths = tuple(
+        item.decode(errors="surrogateescape")
+        for item in raw_paths.split(b"\0")
+        if item
+    )
+    return patch_path, paths
+
+
+def _local_conflicts(original_root: Path, changed_paths: Iterable[str]) -> tuple[str, ...]:
+    conflicts: list[str] = []
+    for path in changed_paths:
+        status = _git(
+            original_root,
+            "status",
+            "--porcelain",
+            "--untracked-files=all",
+            "--",
+            path,
+        ).stdout
+        if status.strip():
+            conflicts.append(path)
+    return tuple(conflicts)
+
+
+def _apply_verified_change(
+    context: RepositoryContext,
+    *,
+    mission_id: str,
+    base_commit: str,
+    verified_commit: str,
+    apply: bool,
+) -> ApplyResult:
+    patch_path, changed_paths = _write_patch(
+        context.original_root,
+        mission_id=mission_id,
+        base_commit=base_commit,
+        verified_commit=verified_commit,
+    )
+    if not changed_paths:
+        return ApplyResult(False, patch_path, (), reason="verified commit has no changed files")
+    if not apply:
+        return ApplyResult(False, patch_path, changed_paths, reason="automatic apply disabled")
+    conflicts = _local_conflicts(context.original_root, changed_paths)
+    if conflicts:
+        return ApplyResult(
+            False,
+            patch_path,
+            changed_paths,
+            conflicts,
+            "verified paths overlap existing local changes",
+        )
+    check = _git(
+        context.original_root,
+        "apply",
+        "--check",
+        "--whitespace=nowarn",
+        str(patch_path),
+        check=False,
+    )
+    if check.returncode != 0:
+        return ApplyResult(
+            False,
+            patch_path,
+            changed_paths,
+            reason=check.stderr.strip() or "patch no longer applies cleanly",
+        )
+    _git(
+        context.original_root,
+        "apply",
+        "--whitespace=nowarn",
+        str(patch_path),
+    )
+    return ApplyResult(True, patch_path, changed_paths)
+
+
+def _result_payload(report: dict, context: RepositoryContext, applied: ApplyResult) -> dict:
+    mission = report["mission"]
+    return {
+        "mission_id": mission["id"],
+        "status": mission["status"],
+        "blocked_reason": mission.get("blocked_reason"),
+        "scope": str(context.invocation_dir),
+        "source_mode": "clean-shadow" if context.shadow_path else "direct",
+        "worktree": mission.get("worktree_path"),
+        "mission_branch": mission.get("branch_name"),
+        "verified_commit": mission.get("verified_commit"),
+        "applied": applied.applied,
+        "changed_paths": list(applied.changed_paths),
+        "conflict_paths": list(applied.conflict_paths),
+        "patch_path": str(applied.patch_path) if applied.patch_path else None,
+        "apply_reason": applied.reason or None,
+        "evidence_chain_valid": report.get("evidence_chain_valid"),
+    }
+
+
+def autopilot_command(args: argparse.Namespace) -> int:
+    parser = getattr(args, "_autopilot_parser", None)
+    objective = str(getattr(args, "objective", "") or "").strip()
+    if not objective:
+        if parser is not None:
+            parser.print_help()
+        return 2
+    board = args.board or kb.get_current_board()
+    context: Optional[RepositoryContext] = None
+    try:
+        context = _prepare_repository(args.repo)
+        allowed = _allowed_paths(context.scope_prefix, args.path)
+        verification = _verification_commands(context.scope_prefix, args.verify)
+        project_id = _ensure_project(context, board)
+        contract = mdb.MissionContract(
+            outcome=(args.outcome or objective).strip(),
+            verification=verification,
+            constraints=[
+                "Make the smallest complete change required by the objective.",
+                "Do not create a nested Git repository.",
+            ],
+            boundaries={
+                "allowed_roots": [str(context.source_repo)],
+                "allowed_paths": allowed,
+                "containment_mode": "workspace-permissive",
+                "network_destinations": [],
+            },
+            stop_when=["The objective requires information that is not present in the repository."],
+            allow_local_commit=True,
+        )
+        with kb.connect_closing(board=board) as conn:
+            mission = mission_service.create_mission(
+                conn,
+                objective=objective,
+                contract=contract,
+                autonomy_level=4,
+                repo_path=str(context.source_repo),
+                board=board,
+                risk_level="low",
+                project_id=project_id,
+                budget={"evidence_bytes": 100 * 1024 * 1024},
+            )
+            mission_service.add_execution_task(
+                conn,
+                mission.id,
+                title=objective[:120],
+                body=_task_body(objective, context.scope_prefix),
+                assignee=args.profile,
+                parents=[],
+            )
+            mission = mission_service.finish_plan(
+                conn,
+                mission.id,
+                verifier_assignee=args.profile,
+            )
+            mission = mission_service.start_mission(conn, mission.id)
+        if not args.json:
+            mode = "clean shadow" if context.shadow_path else "repository"
+            print(f"Autopilot {mission.id}: working in {mode} for {context.invocation_dir}")
+        report = _wait_for_mission(
+            board,
+            mission.id,
+            profile=args.profile,
+            timeout=args.timeout,
+            poll=args.poll,
+            quiet=args.json,
+        )
+        current = report["mission"]
+        if current["status"] != "succeeded":
+            payload = _result_payload(
+                report,
+                context,
+                ApplyResult(False, None, (), reason="mission did not succeed"),
+            )
+            if args.json:
+                print(json.dumps(payload, indent=2, default=str))
+            else:
+                print(f"Autopilot stopped: {current['status']}")
+                if current.get("blocked_reason"):
+                    print(f"Reason: {current['blocked_reason']}")
+                print(f"Worktree: {current.get('worktree_path')}")
+            return 1
+        verified = str(current.get("verified_commit") or "").strip()
+        base = str(current.get("base_commit") or "").strip()
+        if not verified or not base:
+            raise AutopilotError("mission succeeded without a verifiable commit identity")
+        applied = _apply_verified_change(
+            context,
+            mission_id=mission.id,
+            base_commit=base,
+            verified_commit=verified,
+            apply=not args.no_apply,
+        )
+        payload = _result_payload(report, context, applied)
+        if args.json:
+            print(json.dumps(payload, indent=2, default=str))
+        else:
+            print("Autopilot completed and independently verified the task.")
+            print(f"Verified commit: {verified}")
+            if applied.applied:
+                print(f"Applied to: {context.original_root}")
+            else:
+                print(f"Result kept as patch: {applied.patch_path}")
+                if applied.reason:
+                    print(f"Not applied automatically: {applied.reason}")
+                if applied.conflict_paths:
+                    print("Conflicts: " + ", ".join(applied.conflict_paths))
+            if applied.changed_paths:
+                print("Changed: " + ", ".join(applied.changed_paths))
+        return 0
+    except (
+        AutopilotError,
+        ValueError,
+        KeyError,
+        OSError,
+        mission_service.MissionError,
+    ) as exc:
+        if getattr(args, "json", False):
+            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
+        else:
+            print(f"autopilot: {exc}", file=sys.stderr)
+        return 1
+    finally:
+        if context is not None:
+            _cleanup_shadow(context)
