+def test_detect_mode_prefers_mutation_for_combined_request() -> None:
+    assert ap._detect_mode("tell me what this repo has") == "inspect"
+    assert ap._detect_mode("tell me what this repo has and make a linux directory") == "change"
+    assert ap._detect_mode("explain this", "change") == "change"
+
+
+def test_inspection_task_writes_report_without_existing_file_edits() -> None:
+    report = ap._report_path("nested")
+    body = ap._task_body(
+        "tell me what this repo does",
+        "nested",
+        mode="inspect",
+        report_path=report,
+        context_path=ap._context_path("nested"),
+    )
+    assert report == "nested/AUTOPILOT_REPORT.md"
+    assert "Use only the sanitized repository manifest" in body
+    assert f"/workspace/{report}" in body
+    assert "Do not mention the manifest, `.git`" in body
+    assert "Do not recommend deleting" in body
+
+
+def test_unborn_repository_uses_synthetic_clean_shadow(tmp_path: Path, monkeypatch) -> None:
+    repo = tmp_path / "unborn"
+    repo.mkdir()
+    git(repo, "init", "-b", "main")
+    git(repo, "config", "user.name", "Test User")
+    git(repo, "config", "user.email", "test@example.com")
+    (repo / "README.md").write_text("unborn content\n", encoding="utf-8")
+    git(repo, "add", "README.md")
+    monkeypatch.setattr(ap.Path, "home", classmethod(lambda cls: tmp_path / "home"))
+
+    context = ap._prepare_repository(repo)
+    try:
+        assert context.unborn is True
+        assert context.shadow_path is not None
+        assert context.baseline_commit
+        assert git(context.source_repo, "show", "HEAD:README.md") == "unborn content"
+        assert subprocess.run(
+            ["git", "-C", str(repo), "rev-parse", "--verify", "HEAD"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        ).returncode != 0
+    finally:
+        ap._cleanup_shadow(context)
+
+def test_inspection_task_delimits_report_path_for_plan_parser() -> None:
+    report = ap._report_path("")
+    body = ap._task_body(
+        "tell me what this repo does",
+        "",
+        mode="inspect",
+        report_path=report,
