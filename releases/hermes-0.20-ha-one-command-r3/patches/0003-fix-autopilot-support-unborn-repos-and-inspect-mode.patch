+def _detect_mode(objective: str, requested: str = "auto") -> str:
+    if requested in {"change", "inspect"}:
+        return requested
+    value = str(objective or "").strip()
+    if _MUTATION_INTENT.search(value):
+        return "change"
+    if _INSPECTION_INTENT.search(value):
+        return "inspect"
+    return "change"
+
+
+def _report_path(prefix: str) -> str:
+    return f"{prefix}/{_REPORT_NAME}".strip("/") if prefix else _REPORT_NAME
+
+
+def _context_path(prefix: str) -> str:
+    return f"{prefix}/{_CONTEXT_NAME}".strip("/") if prefix else _CONTEXT_NAME
+
+
+def _inspection_context(context: RepositoryContext) -> dict:
+    raw = _git(context.source_repo, "ls-files", "-z", binary=True).stdout
+    files: list[dict[str, object]] = []
+    prefix = context.scope_prefix.rstrip("/")
+    for item in raw.split(b"\0"):
+        if not item:
+            continue
+        repo_path = item.decode(errors="surrogateescape")
+        if repo_path in {_REPORT_NAME, _CONTEXT_NAME}:
+            continue
+        if prefix:
+            if repo_path == prefix:
+                display = Path(repo_path).name
+            elif repo_path.startswith(prefix + "/"):
+                display = repo_path[len(prefix) + 1 :]
+            else:
+                continue
+        else:
+            display = repo_path
+        if display in {_REPORT_NAME, _CONTEXT_NAME} or display.startswith(".git"):
+            continue
+        target = context.source_repo / repo_path
+        try:
+            data = target.read_bytes()
+        except OSError:
+            continue
+        entry: dict[str, object] = {"path": display, "bytes": len(data)}
+        if len(data) <= 20000 and b"\0" not in data:
+            entry["content"] = data.decode("utf-8", errors="replace")
+        else:
+            entry["content"] = None
+            entry["binary_or_large"] = True
+        files.append(entry)
+    return {
+        "scope": "." if not prefix else prefix,
+        "file_count": len(files),
+        "files": files,
+    }
+
+
+def _ensure_inspection_shadow(context: RepositoryContext) -> RepositoryContext:
+    if context.shadow_path is not None:
+        return context
+    shadow = _create_shadow(context.original_root, "HEAD")
+    return RepositoryContext(
+        original_root=context.original_root,
+        invocation_dir=context.invocation_dir,
+        scope_prefix=context.scope_prefix,
+        source_repo=shadow,
+        shadow_path=shadow,
+        dirty=context.dirty,
+        unborn=context.unborn,
+        baseline_commit=context.baseline_commit,
+    )
+
+
+def _commit_inspection_context(context: RepositoryContext, relative_path: str) -> None:
+    payload = _inspection_context(context)
+    target = context.source_repo / relative_path
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(
+        json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    env = os.environ.copy()
+    env.setdefault("GIT_AUTHOR_NAME", "Hermes Autopilot")
+    env.setdefault("GIT_AUTHOR_EMAIL", "autopilot@local")
+    env.setdefault("GIT_COMMITTER_NAME", env["GIT_AUTHOR_NAME"])
+    env.setdefault("GIT_COMMITTER_EMAIL", env["GIT_AUTHOR_EMAIL"])
+    _git(context.source_repo, "add", "--", relative_path, env=env)
+    _git(
+        context.source_repo,
+        "commit",
+        "-m",
+        "chore: stage Autopilot inspection context",
+        env=env,
+    )
+
