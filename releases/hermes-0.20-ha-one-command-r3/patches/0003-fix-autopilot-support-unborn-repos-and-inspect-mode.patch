+def _synthetic_baseline(repo: Path) -> str:
+    temp_root = Path.home() / ".hermes" / "autopilot" / "temporary-indexes"
+    temp_root.mkdir(parents=True, exist_ok=True)
+    index = temp_root / f"index-{int(time.time())}-{os.getpid()}"
+    env = os.environ.copy()
+    env["GIT_INDEX_FILE"] = str(index)
+    env.setdefault("GIT_AUTHOR_NAME", "Hermes Autopilot")
+    env.setdefault("GIT_AUTHOR_EMAIL", "autopilot@local")
+    env.setdefault("GIT_COMMITTER_NAME", env["GIT_AUTHOR_NAME"])
+    env.setdefault("GIT_COMMITTER_EMAIL", env["GIT_AUTHOR_EMAIL"])
+    try:
+        _git(repo, "read-tree", "--empty", env=env)
+        _git(repo, "add", "-A", "--", ".", env=env)
+        tree = _git(repo, "write-tree", env=env).stdout.strip()
+        return _git(
+            repo,
+            "commit-tree",
+            tree,
+            "-m",
+            "Autopilot synthetic baseline",
+            env=env,
+        ).stdout.strip()
+    finally:
+        index.unlink(missing_ok=True)
+
