{
  "schema_version": 1,
  "before_repair": {
    "container_output_owner": "root:root",
    "mode": "0640",
    "host_verifier_readable": false
  },
  "after_repair": {
    "container_output_owner": "host-user:host-group",
    "mode": "0640",
    "host_verifier_readable": true
  },
  "mechanism": "restricted Docker mission containers force --user <host-uid>:<host-gid>"
}
