From eea4d643d1b9f1510fccb4117af57361cb2b6c61 Mon Sep 17 00:00:00 2001
From: Payam Adloo <31391809+piemasterflex111@users.noreply.github.com>
Date: Tue, 4 Aug 2026 12:43:12 -0700
Subject: [PATCH 4/8] fix(mission): preserve host ownership in worktrees

---
 tests/tools/test_mission_docker_scope.py | 3 ++-
 tools/terminal_tool.py                   | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/tests/tools/test_mission_docker_scope.py b/tests/tools/test_mission_docker_scope.py
index f90099c13..a980f92f9 100644
--- a/tests/tools/test_mission_docker_scope.py
+++ b/tests/tools/test_mission_docker_scope.py
@@ -60,7 +60,7 @@ def test_mission_config_scrubs_profile_docker_escape_vectors(tmp_path, monkeypat
     assert config["docker_persist_across_processes"] is False
     assert config["docker_network"] is False
     assert config["docker_orphan_reaper"] is False
-    assert config["docker_run_as_host_user"] is False
+    assert config["docker_run_as_host_user"] is True
     assert config["docker_volumes"] == []
     assert config["docker_forward_env"] == []
     assert config["docker_env"] == {}
@@ -105,6 +105,7 @@ def test_environment_factory_forces_restrictions_when_caller_omits_them(
     assert captured["auto_mount_cwd"] is True
     assert captured["restricted_mode"] is True
     assert captured["persist_across_processes"] is False
+    assert captured["run_as_host_user"] is True
 
 
 def test_mission_file_paths_map_both_directions_before_first_command(
diff --git a/tools/terminal_tool.py b/tools/terminal_tool.py
index 9f0521a8a..a057e9868 100644
--- a/tools/terminal_tool.py
+++ b/tools/terminal_tool.py
@@ -1602,7 +1602,7 @@ def _get_env_config() -> Dict[str, Any]:
         "container_persistent": False if mission_restricted else os.getenv("TERMINAL_CONTAINER_PERSISTENT", "true").lower() in {"true", "1", "yes"},
         "docker_volumes": docker_volumes,
         "docker_env": docker_env,
-        "docker_run_as_host_user": False if mission_restricted else os.getenv("TERMINAL_DOCKER_RUN_AS_HOST_USER", "false").lower() in {"true", "1", "yes"},
+        "docker_run_as_host_user": True if mission_restricted else os.getenv("TERMINAL_DOCKER_RUN_AS_HOST_USER", "false").lower() in {"true", "1", "yes"},
         "docker_network": False if mission_restricted else os.getenv("TERMINAL_DOCKER_NETWORK", "true").lower() in {"true", "1", "yes"},
         "docker_extra_args": docker_extra_args,
         "docker_shm_size": docker_shm_size,
@@ -1679,7 +1679,7 @@ def _create_environment(env_type: str, image: str, cwd: str, timeout: int,
                 "docker_mount_cwd_to_workspace": True,
                 "docker_forward_env": [],
                 "docker_env": {},
-                "docker_run_as_host_user": False,
+                "docker_run_as_host_user": True,
                 "docker_extra_args": [],
                 "docker_network": False,
                 "docker_persist_across_processes": False,
