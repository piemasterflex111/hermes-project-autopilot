@@ -744,3 +751,105 @@ def test_indirect_landlock_denial_is_nonfatal_sandbox_policy_error(
     assert policy_errors
     assert policy_errors[-1]["metadata"]["classification"] == "sandbox_policy_error"
     assert policy_errors[-1]["metadata"]["fatal"] is False
+
+
+def test_workspace_permissive_manifest_treats_contract_paths_as_advisory(
+    tmp_path: Path,
+) -> None:
+    repo = _repo(tmp_path)
+    policy = _policy(
+        repo,
+        allowed=["smoke.txt"],
+        containment_mode="workspace-permissive",
+    )
+    (repo / "README.md").write_text("changed\n", encoding="utf-8")
+    (repo / "generated").mkdir()
+    (repo / "generated" / "extra.txt").write_text("ok\n", encoding="utf-8")
+
+    manifest = guard.workspace_manifest(policy)
+
+    assert manifest["tracked"] == ["README.md"]
+    assert "generated/extra.txt" in manifest["untracked"]
+    assert guard.manifest_violations(policy, manifest) == []
+
+
+def test_workspace_permissive_file_tool_allows_any_in_worktree_path(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from agent import mission_scope
+
+    repo = _repo(tmp_path)
+    policy = _policy(
+        repo,
+        allowed=["smoke.txt"],
+        containment_mode="workspace-permissive",
+    )
+    monkeypatch.setenv("HERMES_MISSION_POLICY", json.dumps(policy))
+    monkeypatch.setattr(
+        mission_scope,
+        "_require_live_executor_lease",
+        lambda current: None,
+    )
+
+    mission_scope.require_write_path(repo / "generated" / "extra.txt")
+
+    with pytest.raises(PermissionError, match="outside"):
+        mission_scope.require_write_path(tmp_path / "outside.txt")
+def test_mission_runtime_defaults_old_contracts_to_workspace_permissive(
+    tmp_path: Path,
+) -> None:
+    from hermes_cli import mission_service as service
+
+    mission = SimpleNamespace(
+        id="m_old",
+        worktree_path=str(tmp_path),
+        contract=SimpleNamespace(boundaries={}),
+    )
+
+    policy = service._mission_runtime_policy(mission)
+
+    assert policy["containment_mode"] == "workspace-permissive"
+
+
+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_workspace_permissive_landlock_allows_normal_worktree_writes(
+    tmp_path: Path,
+) -> None:
+    repo = _repo(tmp_path)
+    policy = _policy(
+        repo,
+        allowed=["smoke.txt"],
+        containment_mode="workspace-permissive",
+    )
+    argv = guard.landlock_wrapped_command(
+        "printf 'HERMES_AUTOPILOT_OK\\n' > /workspace/smoke.txt && "
+        "mkdir -p /workspace/generated && "
+        "printf 'extra\\n' > /workspace/generated/extra.txt",
+        policy,
+    )
+
+    proc = subprocess.run(
+        [
+            "docker",
+            "run",
+            "--rm",
+            "--network=none",
+            *docker_env._BASE_SECURITY_ARGS,
+            "-v",
+            f"{repo}:/workspace",
+            "-w",
+            "/workspace",
+            MISSION_IMAGE,
+            *argv,
+        ],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        timeout=60,
+        check=False,
+    )
+
+    assert proc.returncode == 0, proc.stdout
+    assert (repo / "smoke.txt").read_text(encoding="utf-8") == "HERMES_AUTOPILOT_OK\n"
+    assert (repo / "generated" / "extra.txt").read_text(encoding="utf-8") == "extra\n"
