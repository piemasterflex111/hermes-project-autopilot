diff --git a/agent/mission_terminal_guard.py b/agent/mission_terminal_guard.py
index 6d2792d65..cd7259a10 100644
--- a/agent/mission_terminal_guard.py
+++ b/agent/mission_terminal_guard.py
@@ -85,6 +85,10 @@ def path_is_allowed(relative_path: str, allowed_paths: tuple[str, ...]) -> bool:
     return any(value == item or value.startswith(item + "/") for item in allowed_paths)
 
 
+def workspace_is_permissive(policy: dict[str, Any]) -> bool:
+    return str(policy.get("containment_mode") or "strict") == "workspace-permissive"
+
+
 def _git_paths(root: Path, *args: str) -> set[str]:
     proc = subprocess.run(
         ["git", "-C", str(root), *args],
@@ -131,6 +135,8 @@ def workspace_manifest(policy: dict[str, Any]) -> dict[str, list[str]]:
 def manifest_violations(
     policy: dict[str, Any], manifest: dict[str, list[str]]
 ) -> list[str]:
+    if workspace_is_permissive(policy):
+        return []
     allowed = normalized_allowed_paths(policy)
     violations = {
         path
@@ -386,20 +392,26 @@ grant("/dev/null", FILE_RIGHTS)
 spec = json.loads(sys.argv[2])
 allowed = spec["allowed_paths"]
 read_only_workspace = bool(spec["read_only_workspace"])
+containment_mode = str(spec.get("containment_mode") or "strict")
 if not read_only_workspace:
-    for item in allowed:
-        path = "/workspace/" + item.strip("/")
-        if os.path.isdir(path):
-            grant(path, WORKSPACE_WRITE_RIGHTS)
-        elif os.path.isfile(path):
-            grant(path, FILE_RIGHTS)
-        else:
-            # Landlock rules can only name existing filesystem objects. Missing
-            # approved paths must be created through Hermes file tools, which
-            # enforce the exact relative path before mutation.
-            continue
-    if not allowed:
-        grant("/workspace", WORKSPACE_WRITE_RIGHTS)
+    if containment_mode == "workspace-permissive":
+        # The isolated Git worktree is the execution boundary. Permit normal
+        # shell, compiler, package-manager, and file-tool writes anywhere
+        # beneath /workspace while leaving host paths unmounted.
+        grant("/workspace", SCRATCH_WRITE_RIGHTS)
+    else:
+        for item in allowed:
+            path = "/workspace/" + item.strip("/")
+            if os.path.isdir(path):
+                grant(path, WORKSPACE_WRITE_RIGHTS)
+            elif os.path.isfile(path):
+                grant(path, FILE_RIGHTS)
+            else:
+                # Strict mode cannot grant a missing inode. The validated
+                # Hermes file tool remains the creation path in this mode.
+                continue
+        if not allowed:
+            grant("/workspace", WORKSPACE_WRITE_RIGHTS)
 if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
     err = ctypes.get_errno()
     raise OSError(err, os.strerror(err))
@@ -448,6 +460,7 @@ def landlock_wrapped_command(
         {
             "allowed_paths": list(normalized_allowed_paths(policy)),
             "read_only_workspace": bool(read_only_workspace),
+            "containment_mode": str(policy.get("containment_mode") or "strict"),
         },
         separators=(",", ":"),
     )
