+def _validate_objective(objective: str) -> None:
+    value = " ".join(str(objective or "").split()).strip()
+    normalized = value.casefold().strip(" .!?;:")
+    words = re.findall(r"[A-Za-z0-9]+", value)
+    if normalized in _VAGUE_OBJECTIVES or (
+        len(words) < 2 and not _FILE_TOKEN_RE.search(value)
+    ):
+        raise AutopilotError(
+            "task is too vague; name the file, question, or result, for example "
+            "`hai README.md` or `ham create NOTES.md`"
+        )
+
+
+def _protected_worktree_path(path: Path) -> bool:
+    resolved = path.expanduser().resolve(strict=False)
+    shadow_root = Path.home() / ".hermes" / "autopilot" / "shadows"
+    return (
+        resolved == shadow_root
+        or shadow_root in resolved.parents
+        or any(part in _PROTECTED_WORKTREE_PARTS for part in resolved.parts)
+    )
+
+
+def _explicit_input_names(
+    objective: str,
+    mode: str,
+    explicit: Iterable[str],
+) -> list[str]:
+    values = [str(item).strip() for item in explicit if str(item).strip()]
+    for match in _FILE_TOKEN_RE.finditer(objective):
+        token = match.group(0).strip("`'\".,:;()[]{}")
+        if mode == "inspect":
+            values.append(token)
+            continue
+        prefix = objective[max(0, match.start() - 48) : match.start()]
+        if _INPUT_CUE_RE.search(prefix):
+            values.append(token)
+    return list(dict.fromkeys(values))
+
+
+def _input_candidates(invocation_dir: Path) -> list[str]:
+    values: list[str] = []
+    for path in invocation_dir.rglob("*"):
+        if len(values) >= 5000:
+            break
+        if not path.is_file():
+            continue
+        if any(
+            part == ".git" or part in _PROTECTED_WORKTREE_PARTS
+            for part in path.parts
+        ):
+            continue
+        values.append(path.relative_to(invocation_dir).as_posix())
+    return values
+
+
+def _resolve_input_files(
+    context: RepositoryContext,
+    requested: Iterable[str],
+) -> tuple[InputFile, ...]:
+    resolved: list[InputFile] = []
+    for raw in requested:
+        value = str(raw).strip().strip("`'\"")
+        candidate = Path(value).expanduser()
+        target = candidate if candidate.is_absolute() else context.invocation_dir / candidate
+        target = target.resolve(strict=False)
+        try:
+            target.relative_to(context.invocation_dir)
+            repo_relative = target.relative_to(context.original_root).as_posix()
+        except ValueError as exc:
+            raise AutopilotError(
+                f"input file must stay inside the selected folder: {value}"
+            ) from exc
+        if not target.is_file() or target.is_symlink():
+            candidates = _input_candidates(context.invocation_dir)
+            names = candidates + [Path(item).name for item in candidates]
+            suggestion = difflib.get_close_matches(
+                value,
+                names,
+                n=1,
+                cutoff=0.55,
+            )
+            hint = f" Did you mean: {suggestion[0]}?" if suggestion else ""
+            raise AutopilotError(f"source file not found: {value}.{hint}")
+        resolved.append(InputFile(requested=value, repo_path=repo_relative))
+    unique = {item.repo_path: item for item in resolved}
+    return tuple(unique.values())
+
