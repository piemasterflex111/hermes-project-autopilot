+def _snapshot_input_files(
+    context: RepositoryContext,
+    inputs: Iterable[InputFile],
+) -> tuple[str, ...]:
+    paths = tuple(item.repo_path for item in inputs)
+    if not paths or context.source_repo == context.original_root:
+        return paths
+    for repo_path in paths:
+        source = context.original_root / repo_path
+        target = context.source_repo / repo_path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(source, target)
+    env = _git_identity_env()
+    _git(context.source_repo, "add", "--", *paths, env=env)
+    changed = _git(
+        context.source_repo,
+        "status",
+        "--porcelain",
+        "--",
+        *paths,
+        env=env,
+    ).stdout.strip()
+    if changed:
+        _git(
+            context.source_repo,
+            "commit",
+            "-m",
+            "chore: snapshot Autopilot input files",
+            env=env,
+        )
+    return paths
+
