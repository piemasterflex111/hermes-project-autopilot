+def _inspection_source_text(
+    original_root: Path,
+    inputs: Iterable[InputFile],
+) -> str:
+    parts: list[str] = []
+    for item in inputs:
+        try:
+            data = (original_root / item.repo_path).read_bytes()
+        except OSError:
+            continue
+        if len(data) <= 100000 and b"\0" not in data:
+            parts.append(data.decode("utf-8", errors="replace"))
+    return "\n".join(parts)
+
+
+def _ground_next_action_sections(value: str, source_text: str) -> str:
+    if not source_text.strip():
+        return value
+    source_lower = source_text.casefold()
+    sections = re.split(r"(?m)(?=^##+\s+)", value)
+    cleaned: list[str] = []
+    for section in sections:
+        heading = section.splitlines()[0].casefold() if section.splitlines() else ""
+        if "action" not in heading:
+            cleaned.append(section)
+            continue
+        paragraphs = re.split(r"(\n\s*\n)", section)
+        kept: list[str] = []
+        for paragraph in paragraphs:
+            if not paragraph.strip() or paragraph.startswith("\n"):
+                kept.append(paragraph)
+                continue
+            sentences = re.split(r"(?<=[.!?])\s+", paragraph)
+            valid: list[str] = []
+            for sentence in sentences:
+                lowered = sentence.casefold()
+                unsupported = [
+                    term
+                    for term in _HIGH_RISK_ACTION_TERMS
+                    if term in lowered and term not in source_lower
+                ]
+                negative = False
+                for term in unsupported:
+                    escaped = re.escape(term)
+                    directly_negated = re.search(
+                        rf"\b(?:no|not|do not|does not|cannot|can't)\s+"
+                        rf"(?:\w+\s+){{0,2}}{escaped}\b",
+                        lowered,
+                    )
+                    explicitly_unsupported = re.search(
+                        rf"{escaped}.{{0,60}}\b(?:not supported|unsupported|"
+                        rf"not present|not provided|requires information)\b",
+                        lowered,
+                    )
+                    if directly_negated or explicitly_unsupported:
+                        negative = True
+                        break
+                if unsupported and not negative:
+                    continue
+                valid.append(sentence)
+            if valid:
+                kept.append(" ".join(valid))
+        cleaned.append("".join(kept))
+    return "".join(cleaned)
+
+
+def _sanitize_inspection_answer(answer: str, source_text: str = "") -> str:
+    value = str(answer or "")
+    value = re.sub(
+        r"\b(?:repository|repo)\s+at\s+`?/workspace`?",
+        "selected repository",
+        value,
+        flags=re.IGNORECASE,
+    )
+    value = re.sub(
+        r"`?/workspace/([^`\s]+)`?",
+        lambda match: f"`{match.group(1).rstrip('.,:;')}`",
+        value,
+    )
+    value = value.replace("`/workspace`", "the selected repository")
+    value = value.replace("/workspace", "the selected repository")
+    value = re.sub(r"`?\.git`?", "Git metadata", value)
+    value = re.sub(r"\bmanifest\b", "source snapshot", value, flags=re.IGNORECASE)
+    value = _ground_next_action_sections(value, source_text)
+    return value.strip()
+
+
+def _save_inspection_answer(
+    answer: str,
+    *,
+    mission_id: str,
+    context: RepositoryContext,
+) -> Path:
+    root = Path.home() / ".hermes" / "autopilot" / "answers"
+    root.mkdir(parents=True, exist_ok=True)
+    stamp = time.strftime("%Y%m%d-%H%M%S")
+    path = root / f"{stamp}-{_safe_slug(context.original_root.name)}-{mission_id}.md"
+    path.write_text(
+        answer.rstrip()
+        + "\n\n---\n"
+        + f"Mission: `{mission_id}`\n"
+        + "Independent verification: passed\n",
+        encoding="utf-8",
+    )
+    return path
