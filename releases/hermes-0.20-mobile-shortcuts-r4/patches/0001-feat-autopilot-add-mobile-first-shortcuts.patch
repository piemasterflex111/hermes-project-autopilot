diff --git a/scripts/autopilot_mobile/hapaste b/scripts/autopilot_mobile/hapaste
new file mode 100755
index 000000000..834c14165
--- /dev/null
+++ b/scripts/autopilot_mobile/hapaste
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -euo pipefail
+scratch="$HOME/.hermes/autopilot/mobile-paste"
+input="$scratch/PASTE.md"
+mkdir -p "$scratch"
+if ! git -C "$scratch" rev-parse --git-dir >/dev/null 2>&1; then
+  git -C "$scratch" init -b main >/dev/null
+  git -C "$scratch" config user.name "Hermes Autopilot"
+  git -C "$scratch" config user.email "autopilot@local"
+  printf '# Mobile paste workspace\n' > "$scratch/README.md"
+  git -C "$scratch" add README.md
+  git -C "$scratch" commit -m "chore: initialize mobile paste workspace" >/dev/null
+fi
+cleanup() { rm -f "$input"; }
+trap cleanup EXIT INT TERM
+if [[ -t 0 ]]; then
+  echo "Paste the text. Finish with a line containing only: .done"
+  : > "$input"
+  while IFS= read -r line; do
+    [[ "$line" == ".done" ]] && break
+    printf '%s\n' "$line" >> "$input"
+  done
+else
+  cat > "$input"
+fi
+if [[ ! -s "$input" ]]; then
+  echo "hapaste: no text received" >&2
+  exit 2
+fi
+question=${*:-"Explain this in plain English and tell me what to do next."}
+cd "$scratch"
+ha --mode inspect --input-file PASTE.md "$question"
