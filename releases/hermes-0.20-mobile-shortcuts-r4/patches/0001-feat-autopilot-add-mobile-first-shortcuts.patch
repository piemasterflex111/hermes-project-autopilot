+#!/usr/bin/env bash
+set -euo pipefail
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+mkdir -p "$HOME/.local/bin"
+for name in hai ham hapaste; do
+  install -m 0755 "$root/$name" "$HOME/.local/bin/$name"
+done
+printf 'Installed: hai, ham, hapaste\n'
