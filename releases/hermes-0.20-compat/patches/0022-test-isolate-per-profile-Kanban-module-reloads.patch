From: Payam Adloo <31391809+piemasterflex111@users.noreply.github.com>
Date: Mon, 3 Aug 2026 20:53:49 -0700
Subject: [PATCH 22/25] test: isolate per-profile Kanban module reloads

---
 .../hermes_cli/test_kanban_per_profile_cap.py | 41 ++++++++++++++++---
 1 file changed, 35 insertions(+), 6 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_per_profile_cap.py b/tests/hermes_cli/test_kanban_per_profile_cap.py
index b77bd3a30..c1898477e 100644
--- a/tests/hermes_cli/test_kanban_per_profile_cap.py
+++ b/tests/hermes_cli/test_kanban_per_profile_cap.py
@@ -16,16 +16,45 @@ import pytest
 
 @pytest.fixture()
 def isolated_kanban_home_with_profiles(monkeypatch):
-    """Spin up a fresh HERMES_HOME with kanban DB + alpha/beta profiles."""
+    """Spin up a fresh HERMES_HOME and restore exact imported modules."""
     test_home = tempfile.mkdtemp(prefix="kanban_per_profile_cap_test_")
     for prof in ("alpha", "beta", "default"):
         os.makedirs(os.path.join(test_home, "profiles", prof), exist_ok=True)
     monkeypatch.setenv("HERMES_HOME", test_home)
-    for mod in list(sys.modules.keys()):
-        if mod.startswith("hermes_cli") or mod.startswith("hermes_state") or mod == "hermes_constants":
-            del sys.modules[mod]
-    from hermes_cli import kanban_db
-    yield kanban_db
+    selected = lambda name: (
+        name.startswith("hermes_cli")
+        or name.startswith("hermes_state")
+        or name == "hermes_constants"
+    )
+    originals = {name: module for name, module in sys.modules.items() if selected(name)}
+
+    def remove_selected_modules() -> None:
+        current = [name for name in list(sys.modules) if selected(name)]
+        for name in sorted(current, key=lambda value: value.count("."), reverse=True):
+            if "." in name:
+                parent_name, child_name = name.rsplit(".", 1)
+                parent = sys.modules.get(parent_name)
+                if parent is not None and getattr(parent, child_name, None) is sys.modules.get(name):
+                    delattr(parent, child_name)
+            sys.modules.pop(name, None)
+
+    def restore_original_modules() -> None:
+        sys.modules.update(originals)
+        for name, module in sorted(originals.items(), key=lambda item: item[0].count(".")):
+            if "." not in name:
+                continue
+            parent_name, child_name = name.rsplit(".", 1)
+            parent = sys.modules.get(parent_name)
+            if parent is not None:
+                setattr(parent, child_name, module)
+
+    remove_selected_modules()
+    try:
+        from hermes_cli import kanban_db
+        yield kanban_db
+    finally:
+        remove_selected_modules()
+        restore_original_modules()
 
 
 def _fake_spawn(*args, **kwargs):
