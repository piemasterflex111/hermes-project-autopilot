+        </p>
+      </section>
+
+      <section className="rounded border border-(--ui-stroke-tertiary) p-2">
+        <div className="flex items-center gap-2">
+          <p className="text-xs font-medium">Task dependency graph</p>
+          <span className="ml-auto text-[0.625rem] text-(--ui-text-tertiary)">
+            {report.tasks.length} tasks · {report.links.length} links
+          </span>
+        </div>
+        <div className="mt-2 flex flex-col gap-1">
+          {report.tasks.map(task => (
+            <div className="rounded bg-primary/[0.04] px-2 py-1" key={task.id}>
+              <div className="flex gap-2 text-[0.65rem]">
+                <span className="font-medium">{task.title}</span>
+                <span className="ml-auto">
+                  {task.status} · {task.mission_role || 'task'}
+                </span>
+              </div>
+              <p className="font-mono text-[0.58rem] text-(--ui-text-quaternary)">
+                {task.id}
