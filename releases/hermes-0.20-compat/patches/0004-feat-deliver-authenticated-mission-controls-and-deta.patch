+        <div className="mt-2 grid gap-1 text-[0.65rem] text-(--ui-text-tertiary)">
+          <span>Project: {mission.project_id || '—'}</span>
+          <span>Repository: {mission.repo_path}</span>
+          <span>Worktree: {mission.worktree_path || 'not prepared'}</span>
+          <span>Branch: {mission.branch_name || '—'}</span>
+          <span>Base: {mission.base_commit?.slice(0, 12) || '—'}</span>
