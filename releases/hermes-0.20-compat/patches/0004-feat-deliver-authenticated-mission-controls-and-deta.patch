+    parents.set(link.child_id, [...(parents.get(link.child_id) ?? []), link.parent_id])
+  }
+
+  return (
+    <div className="flex min-h-0 flex-col gap-3 overflow-y-auto rounded-md border border-(--ui-border) p-3">
+      <div>
+        <div className="flex items-center gap-2">
+          <span className="text-sm font-semibold">Mission detail</span>
+          <span className="ml-auto font-mono text-[0.625rem] text-(--ui-text-tertiary)">{mission.id}</span>
+        </div>
+        <p className="mt-1 text-xs">{mission.objective}</p>
+        <p className="mt-1 text-[0.65rem] text-(--ui-text-tertiary)">
+          {mission.status} · {mission.phase} · autonomy L{mission.autonomy_level} · risk {mission.risk_level}
+        </p>
+        {mission.blocked_reason && <p className="mt-1 text-xs text-destructive">{mission.blocked_reason}</p>}
+      </div>
+
+      <section className="rounded border border-(--ui-stroke-tertiary) p-2">
