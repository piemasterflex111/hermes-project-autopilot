diff --git a/agent/mission_terminal_guard.py b/agent/mission_terminal_guard.py
index 2dcbd8f28..23c0c928c 100644
--- a/agent/mission_terminal_guard.py
+++ b/agent/mission_terminal_guard.py
@@ -44,6 +44,20 @@ def validate_command(command: str) -> None:
             raise PermissionError(message)
 
 
+def canonicalize_command(command: str, policy: dict[str, Any]) -> str:
+    """Map the exact host mission worktree path to Docker's `/workspace`.
+
+    Mission cards retain the host worktree path for controller auditing. Models
+    may copy that path into a shell command, but it does not exist inside the
+    restricted container. The rewrite is exact and bounded to this mission's
+    worktree; arbitrary host paths are never translated or mounted.
+    """
+    validate_command(command)
+    root = str(_root(policy))
+    pattern = re.compile(re.escape(root) + r"""(?=$|[/\s'";:&|)])""")
+    return pattern.sub("/workspace", command)
+
+
 def _root(policy: dict[str, Any]) -> Path:
     raw = str(policy.get("worktree_path") or "").strip()
     if not raw:
