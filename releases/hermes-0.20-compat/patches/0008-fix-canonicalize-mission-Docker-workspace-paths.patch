         task_id = kb.create_task(
-            conn, title=title, body=body, assignee=assignee,
+            conn, title=title, body=_mission_executor_body(body), assignee=assignee,
             created_by="mission-planner", parents=dependencies,
             workspace_kind="worktree", workspace_path=mission.worktree_path,
             branch_name=mission.branch_name, project_id=mission.project_id,
@@ -611,6 +611,21 @@ def _add_execution_task_unlocked(
     return task_id
 
 
+_MISSION_EXECUTOR_RUNTIME_NOTE = (
+    "Mission runtime boundary: the existing repository root inside terminal "
+    "commands is /workspace. Never cd to or reference the host workspace_path. "
+    "Use repository-relative paths or /workspace paths. Create missing root "
+    "files with Hermes file tools rather than shell redirection."
+)
+
+
+def _mission_executor_body(body: str) -> str:
+    text = body.strip()
+    if _MISSION_EXECUTOR_RUNTIME_NOTE in text:
+        return text
+    return text + "\n\n" + _MISSION_EXECUTOR_RUNTIME_NOTE
+
+
 _PLAN_VERIFIER_TITLE = "Independently verify mission acceptance criteria"
 _PLAN_VERIFIER_BODY = (
     "Read the mission contract, Git diff, and evidence. Do not trust executor "
@@ -1126,7 +1141,7 @@ def _materialize_canonical_plan(
             conn, mission,
             role="executor",
             title=item["title"],
-            body=item["body"],
+            body=_mission_executor_body(item["body"]),
             assignee=executor_assignee,
             idempotency_key=_plan_task_key(
                 mission.id, plan_hash, "executor", ordinal,
