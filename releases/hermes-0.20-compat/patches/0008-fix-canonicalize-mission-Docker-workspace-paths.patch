diff --git a/tests/tools/test_mission_terminal_containment.py b/tests/tools/test_mission_terminal_containment.py
index 540571394..69f3c88e8 100644
--- a/tests/tools/test_mission_terminal_containment.py
+++ b/tests/tools/test_mission_terminal_containment.py
@@ -459,3 +459,20 @@ def test_terminal_tool_blocks_mission_on_landlock_denial(
     command_evidence = [item for item in evidence if item["kind"] == "command"]
     assert command_evidence
     assert command_evidence[-1]["metadata"]["containment"]["violations"] == []
+
+
+def test_command_maps_exact_host_worktree_to_container_root(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    command = f"cd {repo} && python3 -m py_compile src/base.py && echo {repo}-backup"
+
+    canonical = guard.canonicalize_command(command, _policy(repo))
+
+    assert canonical.startswith("cd /workspace &&")
+    assert f"{repo}-backup" in canonical
+
+
+def test_command_without_host_worktree_is_unchanged(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    command = "cd /workspace && python3 -m py_compile src/base.py"
+
+    assert guard.canonicalize_command(command, _policy(repo)) == command
