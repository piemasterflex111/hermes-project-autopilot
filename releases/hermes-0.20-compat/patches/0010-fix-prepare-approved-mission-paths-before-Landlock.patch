+def test_start_prepares_missing_approved_parent_directory(mission_env):
+    conn, repo = mission_env
+    contract = _contract(repo, allowed_paths=["scripts"])
+    mid = mdb.create_mission(
+        conn,
+        objective="Create an integrity script",
+        contract=contract,
+        autonomy_level=4,
+        repo_path=str(repo),
+        board="default",
+    )
+    mission = service.prepare_mission(conn, mid)
+    service.add_execution_task(
+        conn,
+        mid,
+        title="Create integrity script",
+        body=(
+            "Create scripts/verify_integrity.sh and verify it with "
+            "bash scripts/verify_integrity.sh"
+        ),
+        assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    scripts = Path(mission.worktree_path) / "scripts"
+    assert not scripts.exists()
+
+    started = service.start_mission(conn, mid)
+
+    assert started.status == "running"
+    assert scripts.is_dir()
+    evidence = [
+        row for row in mdb.list_evidence(conn, mid)
+        if row["kind"] == "workspace_preparation"
+    ]
+    assert len(evidence) == 1
+    assert evidence[0]["status"] == "passed"
+    assert evidence[0]["metadata"]["created_directories"] == ["scripts"]
+    assert evidence[0]["metadata"]["required_directories"] == ["scripts"]
+    assert len(evidence[0]["metadata"]["sha256"]) == 64
+
+
+def test_start_rejects_symbolic_link_parent_for_approved_output(mission_env):
+    conn, repo = mission_env
+    contract = _contract(repo, allowed_paths=["scripts"])
+    mid = mdb.create_mission(
+        conn,
+        objective="Create an integrity script",
+        contract=contract,
+        autonomy_level=4,
+        repo_path=str(repo),
+        board="default",
+    )
+    mission = service.prepare_mission(conn, mid)
+    service.add_execution_task(
+        conn,
+        mid,
+        title="Create integrity script",
+        body="Create scripts/verify_integrity.sh",
+        assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    outside = repo.parent / "outside-scripts"
+    outside.mkdir()
+    (Path(mission.worktree_path) / "scripts").symlink_to(
+        outside, target_is_directory=True
+    )
+
+    current = mdb.get_mission(conn, mid)
+    assert current is not None
+    with pytest.raises(service.MissionError, match="symbolic-link parent"):
+        service._prepare_approved_parent_directories(conn, current)
+
+    assert mdb.get_mission(conn, mid).status == "ready"
+    assert not list(outside.iterdir())
+
+
+def test_retry_prepares_missing_approved_parent_without_recreating_mission(
+    mission_env,
+):
+    conn, repo = mission_env
+    contract = _contract(repo, allowed_paths=["scripts"])
+    mid = mdb.create_mission(
+        conn,
+        objective="Create an integrity script",
+        contract=contract,
+        autonomy_level=4,
+        repo_path=str(repo),
+        board="default",
+    )
+    mission = service.prepare_mission(conn, mid)
+    executor = service.add_execution_task(
+        conn,
+        mid,
+        title="Create integrity script",
+        body="Create scripts/verify_integrity.sh",
+        assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    service.start_mission(conn, mid)
+    scripts = Path(mission.worktree_path) / "scripts"
+    scripts.rmdir()
+    assert not scripts.exists()
+    assert kb.block_task(
+        conn,
+        executor,
+        reason="approved directory was not prepared",
+        kind="capability",
+    )
+    mdb.transition_mission(
+        conn,
+        mid,
+        "blocked",
+        phase="execution",
+        blocked_reason="approved directory was not prepared",
+    )
+
+    retried = service.retry_mission(conn, mid)
+
+    assert retried.status == "running"
+    assert scripts.is_dir()
+    assert kb.get_task(conn, executor).status in {"ready", "todo"}
+    preparation = [
+        row for row in mdb.list_evidence(conn, mid)
+        if row["kind"] == "workspace_preparation"
+    ]
+    assert len(preparation) == 2
+    assert preparation[-1]["metadata"]["created_directories"] == ["scripts"]
+
+
