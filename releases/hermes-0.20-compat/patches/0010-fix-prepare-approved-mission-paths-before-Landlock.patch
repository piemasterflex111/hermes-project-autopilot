+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_landlock_allows_write_under_prepared_approved_directory(
+    tmp_path: Path,
+) -> None:
+    repo = _repo(tmp_path)
+    (repo / "scripts").mkdir()
+    policy = _policy(repo, allowed=["scripts"])
+    argv = guard.landlock_wrapped_command(
+        "mkdir -p /workspace/scripts && "
+        "touch /workspace/scripts/check.sh",
+        policy,
+    )
+
+    proc = subprocess.run(
+        [
+            "docker",
+            "run",
+            "--rm",
+            "--network=none",
+            "--cap-drop=ALL",
+            "--cap-add=DAC_OVERRIDE",
+            "--security-opt=no-new-privileges",
+            "-v",
+            f"{repo}:/workspace",
+            "-w",
+            "/workspace",
+            MISSION_IMAGE,
+            *argv,
+        ],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        timeout=60,
+        check=False,
+    )
+
+    assert proc.returncode == 0, proc.stdout
+    assert (repo / "scripts" / "check.sh").is_file()
+    assert not (repo / "forbidden.py").exists()
+
+
 @REQUIRES_LOCAL_MISSION_IMAGE
 def test_runtime_preflight_proves_real_image_and_landlock(tmp_path: Path) -> None:
     repo = _repo(tmp_path)
