+def _accepted_executor_path_hints(conn, mission: mdb.Mission) -> list[str]:
+    """Return normalized repository-relative paths from the accepted plan.
+
+    Automatic plans carry an immutable ``paths`` list. Manual plans predate
+    that structured field, so their accepted executor bodies are scanned with
+    the same conservative path grammar used during planning. The result is
+    only used to prepare parent directories; it never creates the leaf object.
+    """
+    hints: set[str] = set()
+    plan_row = mdb.get_plan(conn, mission.id)
+    if plan_row is not None:
+        tasks, _executor, _verifier = _load_canonical_plan(plan_row)
+        for index, task in enumerate(tasks, start=1):
+            for raw in task.get("paths") or []:
+                hints.add(_normalize_planned_path(mission, raw, task_index=index))
+            for match in _PLAN_PATH_RE.findall(str(task.get("body") or "")):
+                hints.add(_normalize_planned_path(mission, match, task_index=index))
+    else:
+        rows = conn.execute(
+            """SELECT body FROM tasks
+                 WHERE mission_id=? AND mission_role='executor'
+                 ORDER BY created_at,id""",
+            (mission.id,),
+        ).fetchall()
+        for index, row in enumerate(rows, start=1):
+            for match in _PLAN_PATH_RE.findall(str(row["body"] or "")):
+                hints.add(_normalize_planned_path(mission, match, task_index=index))
+    return sorted(hints, key=os.fsencode)
+
+
+def _path_is_inside_allowed_scope(relative: str, allowed: tuple[str, ...]) -> bool:
+    if not relative or relative == ".git" or relative.startswith(".git/"):
+        return False
+    if not allowed:
+        return True
+    return any(
+        relative == item
+        or relative.startswith(item + "/")
+        or item.startswith(relative + "/")
+        for item in allowed
+    )
+
+
+def _prepare_approved_parent_directories(conn, mission: mdb.Mission) -> dict[str, Any]:
+    """Materialize approved missing parents before Landlock is enforced.
+
+    Landlock path rules can only be attached to filesystem objects that already
+    exist. The trusted controller therefore creates the minimum parent
+    directory chain needed by accepted task outputs. Existing symlinks, files,
+    and any ``.git`` path fail closed. Leaf files and directories remain worker
+    outputs and are never created here.
+    """
+    if not mission.worktree_path:
+        raise MissionError("mission workspace preparation requires a worktree")
+    root = Path(mission.worktree_path).resolve(strict=True)
+    allowed = tuple(
+        sorted(
+            {
+                str(item).strip().strip("/")
+                for item in mission.contract.boundaries.get("allowed_paths", [])
+                if str(item).strip().strip("/")
+            },
+            key=os.fsencode,
+        )
+    )
+    hints = _accepted_executor_path_hints(conn, mission)
+    required: set[str] = set()
+    for hint in hints:
+        parts = Path(hint).parts
+        for depth in range(1, len(parts)):
+            relative = Path(*parts[:depth]).as_posix()
+            if not _path_is_inside_allowed_scope(relative, allowed):
+                raise MissionError(
+                    f"workspace preparation path is outside the mission contract: {relative}"
+                )
+            required.add(relative)
+
+    created: list[str] = []
+    existing: list[str] = []
+    for relative in sorted(required, key=lambda item: (item.count("/"), os.fsencode(item))):
+        target = root / relative
+        try:
+            target.lstat()
+        except FileNotFoundError:
+            parent = target.parent.resolve(strict=True)
+            if parent != root and root not in parent.parents:
+                raise MissionError(
+                    f"workspace preparation escaped the mission worktree: {relative}"
+                )
+            os.mkdir(target, mode=0o755)
+            created.append(relative)
+            continue
+        if target.is_symlink():
+            raise MissionError(
+                f"workspace preparation refuses symbolic-link parent: {relative}"
+            )
+        if not target.is_dir():
+            raise MissionError(
+                f"workspace preparation parent is not a directory: {relative}"
+            )
+        existing.append(relative)
+
+    report = {
+        "version": 1,
+        "worktree": str(root),
+        "path_hints": hints,
+        "required_directories": sorted(required, key=os.fsencode),
+        "created_directories": sorted(created, key=os.fsencode),
+        "existing_directories": sorted(existing, key=os.fsencode),
+    }
+    canonical = json.dumps(
+        report, ensure_ascii=False, sort_keys=True, separators=(",", ":")
+    )
+    report["sha256"] = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+    store_evidence_blob(
+        conn,
+        mission,
+        kind="workspace_preparation",
+        status="passed",
+        content=json.dumps(report, ensure_ascii=False, sort_keys=True),
+        metadata={
+            "sha256": report["sha256"],
+            "created_directories": report["created_directories"],
+            "required_directories": report["required_directories"],
+        },
+        cwd=str(root),
+    )
+    return report
+
+
