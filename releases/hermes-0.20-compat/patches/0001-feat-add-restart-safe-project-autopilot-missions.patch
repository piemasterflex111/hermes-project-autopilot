+        @method(name)
+        def handler(rid, params: dict) -> dict:
+            try:
+                from hermes_cli import kanban_db as _kb
+                board = params.get("board") or _kb.get_current_board()
+                with _kb.connect_closing(board=board) as conn:
+                    return fn(rid, params, conn, board)
+            except (ValueError, KeyError, OSError) as exc:
+                return _err(rid, 5072, str(exc))
+            except Exception as exc:
+                # Mission policy/state violations are expected client errors,
+                # not gateway faults. Import lazily to preserve the wrapper's
+                # lightweight registration path.
+                try:
+                    from hermes_cli.mission_service import MissionError
+                except Exception:
+                    MissionError = ()  # type: ignore[assignment,misc]
+                if isinstance(exc, MissionError):
+                    return _err(rid, 5072, str(exc))
+                return _err(rid, 5071, str(exc))
+        return handler
+    return decorator
+
+
+@_mission_rpc("missions.list")
+def _(rid, params, conn, board) -> dict:
+    from dataclasses import asdict
+    from hermes_cli import missions_db as mdb
+    rows = mdb.list_missions(conn, status=params.get("status"), limit=params.get("limit", 100))
+    return _ok(rid, {"missions": [asdict(row) for row in rows], "board": board})
+
+
+@_mission_rpc("missions.get")
+def _(rid, params, conn, board) -> dict:
+    from hermes_cli import mission_service as svc
+    return _ok(rid, svc.mission_report(conn, str(params.get("id") or "")))
+
+
+@_mission_rpc("missions.create")
+def _(rid, params, conn, board) -> dict:
+    from hermes_cli import missions_db as mdb
+    risk_level = str(params.get("risk_level") or "medium")
+    if risk_level not in {"low", "medium", "high"}:
+        raise ValueError("risk_level must be one of: low, medium, high")
+    contract = mdb.MissionContract(
+        outcome=str(params.get("outcome") or ""),
+        verification=[str(v) for v in params.get("verification", [])],
+        constraints=[str(v) for v in params.get("constraints", [])],
+        boundaries=dict(params.get("boundaries") or {}),
+        stop_when=[str(v) for v in params.get("stop_when", [])],
+    )
+    mid = mdb.create_mission(
+        conn, objective=str(params.get("objective") or ""), contract=contract,
+        autonomy_level=int(params["autonomy_level"]), repo_path=str(params.get("repo_path") or ""),
+        board=board, risk_level=risk_level,
+        project_id=params.get("project_id"), budget=dict(params.get("budget") or {}),
+        deadline=params.get("deadline"),
+    )
+    return _ok(rid, {"mission_id": mid})
+
+
+@_mission_rpc("missions.action")
+def _(rid, params, conn, board) -> dict:
+    from dataclasses import asdict
+    from hermes_cli import mission_service as svc
+    action = str(params.get("action") or "")
+    mid = str(params.get("id") or "")
+    actions = {
+        "inspect": lambda: svc.inspect_mission(conn, mid),
+        "prepare": lambda: svc.prepare_mission(conn, mid),
+        "start": lambda: svc.start_mission(conn, mid),
+        "pause": lambda: svc.pause_mission(conn, mid),
+        "resume": lambda: svc.resume_mission(conn, mid),
+        "verify": lambda: svc.verify_with_model(conn, mid),
+        "approve": lambda: svc.approve_commit(conn, mid),
+        "commit": lambda: svc.commit_mission(conn, mid),
+        "cancel": lambda: svc.cancel_mission(conn, mid),
+        "rollback": lambda: svc.rollback_mission(conn, mid),
+        "reconcile": lambda: svc.reconcile_mission(conn, mid),
+    }
+    if action not in actions:
+        raise ValueError(f"unknown mission action: {action}")
+    return _ok(rid, {"mission": asdict(actions[action]())})
+
+
+@_mission_rpc("missions.plan_auto")
+def _(rid, params, conn, board) -> dict:
+    from dataclasses import asdict
+    from hermes_cli import mission_service as svc
+    mission = svc.plan_with_model(
+        conn, str(params.get("id") or ""),
+        executor_assignee=str(params.get("executor") or ""),
+        verifier_assignee=str(params.get("verifier") or ""),
+    )
+    return _ok(rid, {"mission": asdict(mission)})
+
+
