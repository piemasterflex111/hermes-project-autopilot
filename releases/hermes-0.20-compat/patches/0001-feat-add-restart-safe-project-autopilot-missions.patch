+        with kanban_db.connect_closing(board=resolved) as conn:
+            return {"missions": [asdict(m) for m in mdb.list_missions(conn, status=status, limit=limit)]}
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc))
+
+
+@router.get("/missions/{mission_id}")
+def get_mission(mission_id: str, board: Optional[str] = Query(default=None)):
+    from hermes_cli import mission_service as svc
+
+    resolved = _resolve_board(board)
+    with kanban_db.connect_closing(board=resolved) as conn:
+        try:
+            return svc.mission_report(conn, mission_id)
+        except KeyError:
+            raise HTTPException(status_code=404, detail="mission not found")
+        except svc.MissionError as exc:
+            raise HTTPException(status_code=409, detail=str(exc))
+
+
+@router.post("/missions", status_code=201)
+def create_mission(payload: MissionCreate, board: Optional[str] = Query(default=None)):
+    from hermes_cli import missions_db as mdb
+
+    resolved = _resolve_board(board)
+    board_slug = resolved or kanban_db.get_current_board()
+    contract = mdb.MissionContract(
+        outcome=payload.outcome,
+        verification=payload.verification,
+        constraints=payload.constraints,
+        boundaries=payload.boundaries,
+        stop_when=payload.stop_when,
+    )
+    try:
+        with kanban_db.connect_closing(board=resolved) as conn:
+            mid = mdb.create_mission(
+                conn, objective=payload.objective, contract=contract,
+                autonomy_level=payload.autonomy_level, repo_path=payload.repo_path,
+                board=board_slug, risk_level=payload.risk_level,
+                project_id=payload.project_id, budget=payload.budget,
