+
+@router.post("/missions/{mission_id}/actions")
+def mission_action(
+    mission_id: str,
+    payload: MissionAction,
+    board: Optional[str] = Query(default=None),
+):
+    from dataclasses import asdict
+    from hermes_cli import mission_service as svc
+
+    resolved = _resolve_board(board)
+    try:
+        with kanban_db.connect_closing(board=resolved) as conn:
+            if payload.action == "inspect":
+                mission = svc.inspect_mission(conn, mission_id)
+            elif payload.action == "prepare":
+                mission = svc.prepare_mission(conn, mission_id)
+            elif payload.action == "plan_auto":
+                if not payload.executor or not payload.verifier:
+                    raise ValueError("plan_auto requires executor and verifier profiles")
+                mission = svc.plan_with_model(
+                    conn, mission_id, executor_assignee=payload.executor,
+                    verifier_assignee=payload.verifier,
+                )
+            elif payload.action == "start":
+                mission = svc.start_mission(conn, mission_id)
+            elif payload.action == "pause":
+                mission = svc.pause_mission(conn, mission_id)
+            elif payload.action == "resume":
+                mission = svc.resume_mission(conn, mission_id)
+            elif payload.action == "verify":
+                mission = svc.verify_with_model(conn, mission_id)
+            elif payload.action == "approve":
+                mission = svc.approve_commit(conn, mission_id)
+            elif payload.action == "commit":
+                mission = svc.commit_mission(conn, mission_id)
+            elif payload.action == "cancel":
+                mission = svc.cancel_mission(conn, mission_id)
+            elif payload.action == "rollback":
+                mission = svc.rollback_mission(conn, mission_id)
+            elif payload.action == "reconcile":
+                mission = svc.reconcile_mission(conn, mission_id)
+            else:
+                raise ValueError(f"unknown mission action: {payload.action}")
+        return {"mission": asdict(mission)}
+    except KeyError:
+        raise HTTPException(status_code=404, detail="mission not found")
+    except (ValueError, svc.MissionError) as exc:
+        raise HTTPException(status_code=409, detail=str(exc))
