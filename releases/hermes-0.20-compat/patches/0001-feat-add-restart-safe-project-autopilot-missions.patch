+function MissionCenter({ onClose, open }: { onClose: () => void; open: boolean }) {
+  const qc = useQueryClient()
+  const slug = useValue($boardSlug)
+  const queryKey = missionsKey(slug)
+  const { data } = useQuery({
+    queryFn: () => fetchMissions(slug),
+    queryKey,
+    enabled: open,
+    refetchInterval: open ? 3_000 : false
+  })
+  const [objective, setObjective] = useState('')
+  const [outcome, setOutcome] = useState('')
+  const [verify, setVerify] = useState('')
+  const [repo, setRepo] = useState('')
+  const [paths, setPaths] = useState('')
+  const [autonomy, setAutonomy] = useState('3')
+  const [executor, setExecutor] = useState('default')
+  const [verifier, setVerifier] = useState('default')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<null | string>(null)
+
+  const refresh = () => qc.invalidateQueries({ queryKey })
+  const create = async () => {
+    if (!objective.trim() || !outcome.trim() || !verify.trim() || !repo.trim() || busy) {
+      return
+    }
+    setBusy(true)
+    setError(null)
+    try {
+      const allowedPaths = paths.split(',').map(v => v.trim()).filter(Boolean)
+      await createMission({
+        autonomy_level: Number(autonomy),
+        boundaries: {
+          allowed_paths: allowedPaths,
+          allowed_roots: [repo.trim()],
+          network_destinations: []
+        },
+        constraints: ['Do not modify unrelated files'],
+        objective: objective.trim(),
+        outcome: outcome.trim(),
+        repo_path: repo.trim(),
+        stop_when: ['The declared scope cannot be enforced'],
+        verification: verify.split('\n').map(v => v.trim()).filter(Boolean)
+      }, slug)
+      setObjective('')
+      setOutcome('')
+      setVerify('')
+      setPaths('')
+      await refresh()
+    } catch (err) {
+      setError(errText(err))
+    } finally {
+      setBusy(false)
+    }
+  }
+  const act = async (id: string, action: string) => {
+    try {
+      await missionAction(id, action, action === 'plan_auto' ? { executor, verifier } : {}, slug)
+      await refresh()
+    } catch (err) {
+      host.notify({ kind: 'error', message: errText(err) })
+    }
+  }
+
+  return (
+    <Dialog onOpenChange={value => !value && onClose()} open={open}>
+      <DialogContent className="w-[min(52rem,94vw)] max-w-none">
+        <DialogHeader><DialogTitle>Project Autopilot missions</DialogTitle></DialogHeader>
+        <div className="grid max-h-[72vh] gap-4 overflow-y-auto md:grid-cols-2">
+          <div className="flex flex-col gap-2">
+            <p className="text-xs font-medium">Create mission</p>
+            <Input onChange={e => setObjective(e.target.value)} placeholder="Objective" value={objective} />
+            <Input onChange={e => setOutcome(e.target.value)} placeholder="Required outcome" value={outcome} />
+            <Textarea onChange={e => setVerify(e.target.value)} placeholder="Verification commands, one per line" value={verify} />
