+              </SelectContent>
+            </Select>
+            <div className="grid grid-cols-2 gap-2">
+              <Input onChange={e => setExecutor(e.target.value)} placeholder="Executor profile" value={executor} />
+              <Input onChange={e => setVerifier(e.target.value)} placeholder="Verifier profile" value={verifier} />
+            </div>
+            {error && <p className="text-xs text-destructive">{error}</p>}
+            <Button disabled={busy} onClick={() => void create()}>{busy ? 'Creating…' : 'Create draft'}</Button>
+          </div>
+          <div className="flex flex-col gap-2">
+            <p className="text-xs font-medium">Missions</p>
+            {(data?.missions ?? []).map(mission => (
+              <div className="rounded-md border border-(--ui-border) p-2" key={mission.id}>
+                <div className="flex items-center gap-2">
+                  <span className="text-xs font-medium">{mission.objective}</span>
+                  <span className="ml-auto text-[0.625rem] text-(--ui-text-tertiary)">{mission.status} · L{mission.autonomy_level}</span>
+                </div>
+                {mission.blocked_reason && <p className="mt-1 text-[0.65rem] text-destructive">{mission.blocked_reason}</p>}
+                {mission.verified_commit && <p className="mt-1 font-mono text-[0.625rem]">{mission.verified_commit.slice(0, 12)}</p>}
+                <div className="mt-2 flex flex-wrap gap-1">
+                  {mission.status === 'draft' && mission.autonomy_level >= 1 && <Button onClick={() => void act(mission.id, 'inspect')} size="xs" variant="ghost">Inspect</Button>}
+                  {mission.status === 'draft' && mission.autonomy_level >= 2 && <Button onClick={() => void act(mission.id, 'prepare')} size="xs" variant="outline">Prepare</Button>}
+                  {mission.status === 'planning' && <Button onClick={() => void act(mission.id, 'plan_auto')} size="xs" variant="outline">Auto plan</Button>}
+                  {mission.status === 'ready' && mission.autonomy_level >= 3 && <Button onClick={() => void act(mission.id, 'start')} size="xs" variant="outline">Start</Button>}
+                  {mission.status === 'running' && <Button onClick={() => void act(mission.id, 'pause')} size="xs" variant="ghost">Pause</Button>}
+                  {mission.status === 'running' && <Button onClick={() => void act(mission.id, 'verify')} size="xs" variant="outline">Verify</Button>}
+                  {mission.status === 'waiting_for_user' && <Button onClick={() => void act(mission.id, 'resume')} size="xs" variant="outline">Resume</Button>}
+                  {mission.status === 'awaiting_approval' && <Button onClick={() => void act(mission.id, 'approve')} size="xs">Approve commit gate</Button>}
+                  {mission.status === 'committing' && <Button onClick={() => void act(mission.id, 'commit')} size="xs">Commit locally</Button>}
+                  {['succeeded', 'failed', 'cancelled', 'blocked'].includes(mission.status) && mission.worktree_path && <Button onClick={() => void act(mission.id, 'rollback')} size="xs" variant="outline">Rollback</Button>}
+                  {!['succeeded', 'failed', 'cancelled', 'rolled_back'].includes(mission.status) && <Button onClick={() => void act(mission.id, 'cancel')} size="xs" variant="ghost">Cancel</Button>}
+                  {!['succeeded', 'failed', 'cancelled', 'rolled_back'].includes(mission.status) && <Button onClick={() => void act(mission.id, 'reconcile')} size="xs" variant="ghost">Reconcile</Button>}
+                </div>
+              </div>
+            ))}
+            {!data?.missions?.length && <p className="text-xs text-(--ui-text-tertiary)">No missions on this board.</p>}
+          </div>
+        </div>
+      </DialogContent>
+    </Dialog>
+  )
+}
