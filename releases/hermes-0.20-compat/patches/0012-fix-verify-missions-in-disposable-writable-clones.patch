+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                timeout=300,
+                check=False,
+                stdin=subprocess.DEVNULL,
+            )
+            finished_at = int(time.time())
         containment = {
             "controller_verification": True,
             "network": "none",
-            "workspace_mount": "read-only",
