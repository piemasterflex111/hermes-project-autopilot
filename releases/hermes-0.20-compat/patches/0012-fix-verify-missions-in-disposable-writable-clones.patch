         argv = landlock_wrapped_command(
             executed,
-            policy,
-            read_only_workspace=True,
-        )
-        started_at = int(time.time())
-        proc = subprocess.run(
-            [
-                docker,
-                "run",
-                "--rm",
-                "--network=none",
-                "--cap-drop=ALL",
-                "--security-opt=no-new-privileges",
-                "-v",
-                f"{root}:/workspace:ro",
-                "-w",
-                "/workspace",
-                image,
-                *argv,
-            ],
-            text=True,
-            stdout=subprocess.PIPE,
-            stderr=subprocess.STDOUT,
-            timeout=300,
-            check=False,
-            stdin=subprocess.DEVNULL,
-        )
-        finished_at = int(time.time())
+            {"allowed_paths": []},
