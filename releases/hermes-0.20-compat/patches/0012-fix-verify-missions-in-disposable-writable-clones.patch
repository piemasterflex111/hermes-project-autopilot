+def _remove_verification_entry(path: Path) -> None:
+    if path.is_symlink() or path.is_file():
+        path.unlink()
+    elif path.is_dir():
+        shutil.rmtree(path)
+    else:
+        raise MissionError(f"unsupported verification workspace entry: {path}")
+
+
+def _copy_verification_entry(source: Path, target: Path) -> None:
+    if source.is_symlink():
+        target.symlink_to(os.readlink(source))
+    elif source.is_dir():
+        shutil.copytree(source, target, symlinks=True)
+    elif source.is_file():
+        shutil.copy2(source, target)
+    else:
+        raise MissionError(f"unsupported verification workspace entry: {source}")
+
+
+@contextlib.contextmanager
+def _ephemeral_verification_workspace(
+    mission: mdb.Mission,
+    root: Path,
+):
+    """Yield an exact, disposable Git checkout for one verification command.
+
+    The authoritative mission worktree is never mounted writable.  A local,
+    no-hardlink clone supplies self-contained Git metadata, then the current
+    mission files are mirrored over its base-commit index.  Commands may create
+    build output inside the copy, but the copy is discarded after that command.
+    """
+    if not mission.repo_path:
+        raise MissionError("verification requires the source repository path")
+    source_repo = Path(mission.repo_path).resolve(strict=True)
+    with tempfile.TemporaryDirectory(prefix="hermes-mission-verify-") as temp_dir:
+        sandbox = Path(temp_dir) / "workspace"
+        clone = subprocess.run(
+            [
+                "git", "clone", "--local", "--no-hardlinks", "--no-checkout",
+                str(source_repo), str(sandbox),
+            ],
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=120,
+            check=False,
+        )
+        if clone.returncode != 0:
+            raise MissionError(
+                clone.stderr.strip() or "could not create verification repository copy"
+            )
+        checkout = subprocess.run(
+            ["git", "-C", str(sandbox), "checkout", "--detach", mission.base_commit],
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=120,
+            check=False,
+        )
+        if checkout.returncode != 0:
+            raise MissionError(
+                checkout.stderr.strip() or "could not prepare verification base commit"
+            )
+        for entry in sandbox.iterdir():
+            if entry.name != ".git":
+                _remove_verification_entry(entry)
+        for entry in root.iterdir():
+            if entry.name != ".git":
+                _copy_verification_entry(entry, sandbox / entry.name)
+        yield sandbox
+
+
