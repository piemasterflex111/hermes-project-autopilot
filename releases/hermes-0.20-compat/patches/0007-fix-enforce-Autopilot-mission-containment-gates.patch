+def _validate_plan_scope(mission: mdb.Mission, tasks: list[dict[str, Any]]) -> None:
+    """Reject planner paths that conflict with the durable mission contract."""
+    for index, task in enumerate(tasks, start=1):
+        declared = task.get("paths")
