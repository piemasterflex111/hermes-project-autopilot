@@ -0,0 +1,461 @@
+"""Regression tests for Project Autopilot terminal containment."""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from agent import mission_terminal_guard as guard
+from tools.environments import docker as docker_env
+
+
+MISSION_IMAGE = "nikolaik/python-nodejs:python3.11-nodejs20"
+
+
+def _mission_image_available() -> bool:
+    if shutil.which("docker") is None:
+        return False
+    proc = subprocess.run(
+        ["docker", "image", "inspect", MISSION_IMAGE],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        timeout=10,
+        check=False,
+    )
+    return proc.returncode == 0
+
+
+REQUIRES_LOCAL_MISSION_IMAGE = pytest.mark.skipif(
+    not _mission_image_available(),
+    reason="the offline mission Docker image is not present locally",
+)
+
+
+def _git(repo: Path, *args: str) -> str:
+    proc = subprocess.run(
+        ["git", "-C", str(repo), *args],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=True,
+    )
+    return proc.stdout.strip()
+
+
+def _repo(tmp_path: Path) -> Path:
+    repo = tmp_path / "repo"
+    tmp_path.chmod(0o755)
+    (repo / "src").mkdir(parents=True)
+    repo.chmod(0o755)
+    (repo / "src").chmod(0o777)
+    (repo / "README.md").write_text("base\n", encoding="utf-8")
+    (repo / "src" / "base.py").write_text("VALUE = 1\n", encoding="utf-8")
+    _git(repo, "init")
+    _git(repo, "config", "user.email", "guard@example.test")
+    _git(repo, "config", "user.name", "Guard Test")
+    _git(repo, "add", ".")
+    _git(repo, "commit", "-m", "base")
+    return repo
+
+
+def _policy(repo: Path, allowed: list[str] | None = None) -> dict:
+    return {
+        "mission_id": "m_guard",
+        "mission_role": "executor",
+        "worktree_path": str(repo),
+        "allowed_paths": ["src"] if allowed is None else allowed,
+        "allowed_terminal_backends": ["docker"],
+        "read_only": False,
+    }
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "git init nested",
+        "cd src && git init",
+        "git worktree add ../other branch",
+        "uv init project-name",
+        "uv init .",
+    ],
+)
+def test_repository_creation_commands_are_rejected(command: str) -> None:
+    with pytest.raises(PermissionError):
+        guard.validate_command(command)
+
+
+def test_manifest_rolls_back_out_of_scope_changes_only(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    policy = _policy(repo)
+    (repo / "src" / "allowed.py").write_text("ALLOWED = True\n", encoding="utf-8")
+    (repo / "README.md").write_text("tampered\n", encoding="utf-8")
+    nested = repo / "unexpected"
+    (nested / ".git").mkdir(parents=True)
+    (nested / "bad.py").write_text("BAD = True\n", encoding="utf-8")
+
+    manifest = guard.workspace_manifest(policy)
+    violations = guard.manifest_violations(policy, manifest)
+
+    assert "README.md" in violations
+    assert "unexpected/.git" in violations
+    assert "unexpected/bad.py" in violations
+    restored = guard.rollback_violations(policy, violations)
+    assert set(restored) == set(violations)
+    assert (repo / "README.md").read_text(encoding="utf-8") == "base\n"
+    assert not nested.exists()
+    assert (repo / "src" / "allowed.py").exists()
+    assert guard.manifest_violations(policy, guard.workspace_manifest(policy)) == []
+
+
+def test_existing_nested_git_blocks_before_command(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    (repo / "src" / "nested" / ".git").mkdir(parents=True)
+    with pytest.raises(PermissionError, match="out-of-scope"):
+        guard.verify_clean_scope(_policy(repo))
+
+
+def test_restricted_docker_uses_landlock_launcher(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    captured: dict[str, object] = {}
+
+    def fake_popen(cmd, stdin_data=None):
+        captured["cmd"] = cmd
+        captured["stdin_data"] = stdin_data
+        return object()
+
+    monkeypatch.setattr(docker_env, "_popen_bash", fake_popen)
+    env = docker_env.DockerEnvironment.__new__(docker_env.DockerEnvironment)
+    env._container_id = "container"
+    env._docker_exe = "docker"
+    env._restricted_mode = True
+    env._mission_policy = {
+        "mission_id": "m_guard",
+        "worktree_path": "/host/repo",
+        "allowed_paths": ["src"],
+    }
+    env._init_env_args = []
+
+    result = env._run_bash("touch /workspace/src/ok.py")
+
+    assert result is not None
+    cmd = captured["cmd"]
+    assert isinstance(cmd, list)
+    assert cmd[:3] == ["docker", "exec", "container"]
+    assert "python3" in cmd
+    assert "Landlock ABI" in cmd[cmd.index("-c") + 1]
+
+
+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_landlock_denies_forbidden_write_in_real_container(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    policy = _policy(repo)
+    argv = guard.landlock_wrapped_command(
+        "touch /workspace/src/allowed.py && touch /workspace/forbidden.py",
+        policy,
+    )
+    proc = subprocess.run(
+        [
+            "docker",
+            "run",
+            "--rm",
+            "--network=none",
+            "--cap-drop=ALL",
+            "--security-opt=no-new-privileges",
+            "-v",
+            f"{repo}:/workspace",
+            "-w",
+            "/workspace",
+            MISSION_IMAGE,
+            *argv,
+        ],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        timeout=60,
+        check=False,
+    )
+    assert proc.returncode != 0, proc.stdout
+    assert (repo / "src" / "allowed.py").exists()
+    assert not (repo / "forbidden.py").exists()
+
+
+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_runtime_preflight_proves_real_image_and_landlock(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+
+    report = guard.runtime_preflight(
+        _policy(repo),
+        image=MISSION_IMAGE,
+    )
+
+    assert report["host_landlock_abi"] >= 3
+    assert report["container_landlock_abi"] >= 3
+    assert report["network"] == "none"
+    assert report["workspace"] == str(repo.resolve())
+    assert report["manifest"] == {
+        "tracked": [],
+        "untracked": [],
+        "nested_git": [],
+    }
+
+
+def test_manifest_includes_ignored_out_of_scope_files(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    (repo / ".gitignore").write_text("ignored/\n", encoding="utf-8")
+    _git(repo, "add", ".gitignore")
+    _git(repo, "commit", "-m", "ignore fixture")
+    ignored = repo / "ignored" / "secret.bin"
+    ignored.parent.mkdir()
+    ignored.write_bytes(b"unsafe")
+
+    manifest = guard.workspace_manifest(_policy(repo))
+    violations = guard.manifest_violations(_policy(repo), manifest)
+
+    assert "ignored/secret.bin" in manifest["untracked"]
+    assert "ignored/secret.bin" in violations
+    guard.rollback_violations(_policy(repo), violations)
+    assert not ignored.exists()
+
+
+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_missing_allowed_root_file_requires_exact_path_file_tool(
+    tmp_path: Path,
+) -> None:
+    repo = _repo(tmp_path)
+    policy = _policy(repo, allowed=["pyproject.toml"])
