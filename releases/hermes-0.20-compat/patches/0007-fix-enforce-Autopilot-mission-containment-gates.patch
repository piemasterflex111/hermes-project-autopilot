+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_ephemeral_python_tool_state_stays_outside_workspace(tmp_path: Path) -> None:
+    repo = _repo(tmp_path)
+    policy = _policy(repo)
+    command = (
+        'uv venv "$UV_PROJECT_ENVIRONMENT" >/dev/null && '
