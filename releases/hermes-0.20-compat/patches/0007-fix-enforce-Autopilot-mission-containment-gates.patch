+"""Fail-closed terminal containment for Project Autopilot missions.
+
+The model is not a security boundary. This module combines static command
+rejection, Linux Landlock, a trusted Git/path manifest, and deterministic
+rollback of out-of-contract filesystem mutations.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+_FORBIDDEN_COMMANDS: tuple[tuple[re.Pattern[str], str], ...] = (
+    (
+        re.compile(r"(?:^|[;&|()\s])git\s+(?:-[^\s]+\s+)*init(?:\s|$)", re.I),
+        "mission terminal blocks git init; the controller owns repository identity",
+    ),
+    (
+        re.compile(
+            r"(?:^|[;&|()\s])git\s+(?:-[^\s]+\s+)*worktree\s+"
+            r"(?:add|move|repair|remove|prune)(?:\s|$)",
+            re.I,
+        ),
+        "mission terminal blocks Git worktree mutation; the controller owns the worktree",
+    ),
+    (
+        re.compile(r"(?:^|[;&|()\s])uv\s+init(?:\s|$)", re.I),
+        "mission terminal blocks uv init; modify the existing repository root explicitly",
+    ),
+)
+
+
+def validate_command(command: str) -> None:
+    """Reject commands that can create or replace repository identity."""
+    for pattern, message in _FORBIDDEN_COMMANDS:
+        if pattern.search(command):
+            raise PermissionError(message)
+
+
+def _root(policy: dict[str, Any]) -> Path:
+    raw = str(policy.get("worktree_path") or "").strip()
+    if not raw:
+        raise PermissionError("mission policy has no worktree path")
+    return Path(raw).expanduser().resolve(strict=True)
+
+
+def normalized_allowed_paths(policy: dict[str, Any]) -> tuple[str, ...]:
+    values: list[str] = []
+    for raw in policy.get("allowed_paths") or []:
+        value = str(raw).strip().strip("/")
+        candidate = Path(value)
+        if not value or candidate.is_absolute() or ".." in candidate.parts:
+            raise PermissionError(f"unsafe mission allowed path: {raw!r}")
+        values.append(candidate.as_posix())
+    return tuple(sorted(set(values)))
+
+
+def path_is_allowed(relative_path: str, allowed_paths: tuple[str, ...]) -> bool:
+    value = Path(relative_path).as_posix().strip("/")
+    if not value:
+        return False
+    if not allowed_paths:
+        return True
+    return any(value == item or value.startswith(item + "/") for item in allowed_paths)
+
+
+def _git_paths(root: Path, *args: str) -> set[str]:
+    proc = subprocess.run(
+        ["git", "-C", str(root), *args],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=30,
+        check=False,
+    )
+    if proc.returncode != 0:
+        error = proc.stderr.decode("utf-8", errors="replace").strip()
+        raise PermissionError(error or f"git {' '.join(args)} failed")
+    return {os.fsdecode(part) for part in proc.stdout.split(b"\0") if part}
+
+
+def nested_git_paths(root: Path) -> set[str]:
+    """Find nested .git files/directories without following symlinks."""
+    found: set[str] = set()
+    for current, directories, files in os.walk(root, topdown=True, followlinks=False):
+        current_path = Path(current)
+        if current_path == root:
+            directories[:] = [name for name in directories if name != ".git"]
+        elif ".git" in directories:
+            git_path = current_path / ".git"
+            found.add(git_path.relative_to(root).as_posix())
+            directories.remove(".git")
+        if current_path != root and ".git" in files:
+            found.add((current_path / ".git").relative_to(root).as_posix())
+    return found
+
+
+def workspace_manifest(policy: dict[str, Any]) -> dict[str, list[str]]:
+    root = _root(policy)
+    tracked = _git_paths(root, "diff", "--name-only", "-z", "HEAD", "--")
+    staged = _git_paths(root, "diff", "--cached", "--name-only", "-z", "HEAD", "--")
+    untracked = _git_paths(root, "ls-files", "--others", "-z")
+    nested = nested_git_paths(root)
+    return {
+        "tracked": sorted(tracked | staged, key=os.fsencode),
+        "untracked": sorted(untracked, key=os.fsencode),
+        "nested_git": sorted(nested, key=os.fsencode),
+    }
+
+
+def manifest_violations(
+    policy: dict[str, Any], manifest: dict[str, list[str]]
+) -> list[str]:
+    allowed = normalized_allowed_paths(policy)
+    violations = {
+        path
+        for group in ("tracked", "untracked")
+        for path in manifest.get(group, [])
+        if not path_is_allowed(path, allowed)
+    }
+    violations.update(manifest.get("nested_git", []))
+    return sorted(violations, key=os.fsencode)
+
+
+def _safe_target(root: Path, relative_path: str) -> Path:
+    candidate = root / relative_path
+    parent = candidate.parent.resolve(strict=False)
+    if parent != root and root not in parent.parents:
+        raise PermissionError(
+            f"refusing to repair path outside mission worktree: {relative_path}"
+        )
+    return candidate
+
+
+def rollback_violations(policy: dict[str, Any], violations: list[str]) -> list[str]:
+    """Restore tracked paths and delete only violating untracked/nested paths."""
+    root = _root(policy)
+    if not violations:
+        return []
+    tracked = _git_paths(root, "ls-files", "-z")
+    restored: list[str] = []
+    for relative in sorted(set(violations), key=lambda item: (-item.count("/"), item)):
+        target = _safe_target(root, relative)
+        if relative in tracked:
+            proc = subprocess.run(
+                [
+                    "git",
+                    "-C",
+                    str(root),
+                    "restore",
+                    "--source=HEAD",
+                    "--staged",
+                    "--worktree",
+                    "--",
+                    relative,
+                ],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+                timeout=30,
+                check=False,
+            )
+            if proc.returncode != 0:
+                raise PermissionError(
+                    proc.stderr.strip()
+                    or f"could not restore violating path: {relative}"
+                )
+            restored.append(relative)
+            continue
+        try:
+            if target.is_symlink() or target.is_file():
+                target.unlink(missing_ok=True)
+            elif target.is_dir():
+                shutil.rmtree(target)
+            else:
+                target.unlink(missing_ok=True)
+            restored.append(relative)
+        except OSError as exc:
+            raise PermissionError(
+                f"could not remove violating path {relative}: {exc}"
+            ) from exc
+        parent = target.parent
+        while parent != root:
+            try:
+                parent.rmdir()
+            except OSError:
+                break
+            parent = parent.parent
+    return sorted(restored, key=os.fsencode)
+
+
+def verify_clean_scope(policy: dict[str, Any]) -> dict[str, list[str]]:
+    manifest = workspace_manifest(policy)
+    violations = manifest_violations(policy, manifest)
+    if violations:
+        raise PermissionError(
+            "mission worktree already contains out-of-scope mutations: "
+            + ", ".join(violations)
+        )
+    return manifest
+
+
+def landlock_abi() -> int:
+    """Return the host Landlock ABI, or zero when unavailable."""
+    if os.name != "posix":
+        return 0
+    import ctypes
+    import platform
+
+    if platform.machine() not in {"x86_64", "aarch64"}:
+        return 0
+    libc = ctypes.CDLL(None, use_errno=True)
+    result = int(libc.syscall(444, 0, 0, 1))
+    return result if result > 0 else 0
+
+
+def runtime_preflight(policy: dict[str, Any], *, image: str) -> dict[str, Any]:
+    """Prove the real offline Docker/Landlock runtime before model planning."""
+    manifest = verify_clean_scope(policy)
+    host_abi = landlock_abi()
+    if host_abi < 3:
+        raise PermissionError(
+            "Project Autopilot requires Linux Landlock ABI 3 or newer"
+        )
+    from tools.environments.docker import find_docker
+
+    docker = find_docker()
+    if not docker:
+        raise PermissionError("Project Autopilot requires the Docker executable")
+    daemon = subprocess.run(
+        [docker, "info", "--format", "{{.ServerVersion}}"],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=15,
+        check=False,
+        stdin=subprocess.DEVNULL,
+    )
+    if daemon.returncode != 0:
+        raise PermissionError(
+            "Docker daemon is unavailable: "
+            + (daemon.stderr.strip() or daemon.stdout.strip() or "docker info failed")
+        )
+    inspected = subprocess.run(
+        [docker, "image", "inspect", image, "--format", "{{.Id}}"],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=15,
+        check=False,
+        stdin=subprocess.DEVNULL,
+    )
+    if inspected.returncode != 0:
+        raise PermissionError(f"mission Docker image is not present locally: {image}")
+    root = _root(policy)
+    probe_source = (
+        "import ctypes,os; "
+        "r=int(ctypes.CDLL(None,use_errno=True).syscall(444,0,0,1)); "
+        "print(r); "
+        "raise SystemExit(0 if r>=3 and os.path.isdir('/workspace') else 1)"
+    )
+    probe = subprocess.run(
+        [
+            docker,
+            "run",
+            "--rm",
+            "--network=none",
+            "--cap-drop=ALL",
+            "--security-opt=no-new-privileges",
+            "-v",
+            f"{root}:/workspace:ro",
+            "-w",
+            "/workspace",
+            image,
+            "python3",
+            "-c",
+            probe_source,
+        ],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=45,
+        check=False,
+        stdin=subprocess.DEVNULL,
+    )
+    try:
+        container_abi = int(probe.stdout.strip().splitlines()[-1])
+    except (IndexError, ValueError):
+        container_abi = 0
+    if probe.returncode != 0 or container_abi < 3:
+        detail = probe.stderr.strip() or probe.stdout.strip() or "probe failed"
+        raise PermissionError(f"mission Docker image cannot enforce Landlock: {detail}")
+    return {
+        "docker": docker,
+        "docker_server": daemon.stdout.strip(),
+        "image": image,
+        "image_id": inspected.stdout.strip(),
+        "host_landlock_abi": host_abi,
+        "container_landlock_abi": container_abi,
+        "network": "none",
+        "workspace": str(root),
+        "manifest": manifest,
+    }
+
+
+_LANDLOCK_LAUNCHER = r"""
+import base64, ctypes, json, os, sys
+CREATE, ADD, RESTRICT = 444, 445, 446
+VERSION = 1
+RULE_PATH_BENEATH = 1
+PR_SET_NO_NEW_PRIVS = 38
+O_PATH = getattr(os, "O_PATH", 0o10000000)
+WRITE_FILE = 1 << 1
+REMOVE_DIR = 1 << 4
+REMOVE_FILE = 1 << 5
+MAKE_CHAR = 1 << 6
+MAKE_DIR = 1 << 7
+MAKE_REG = 1 << 8
+MAKE_SOCK = 1 << 9
+MAKE_FIFO = 1 << 10
+MAKE_BLOCK = 1 << 11
+MAKE_SYM = 1 << 12
+REFER = 1 << 13
+TRUNCATE = 1 << 14
+WORKSPACE_WRITE_RIGHTS = (
+    WRITE_FILE | REMOVE_DIR | REMOVE_FILE | MAKE_DIR | MAKE_REG |
+    MAKE_SYM | REFER | TRUNCATE
+)
+SCRATCH_WRITE_RIGHTS = (
+    WORKSPACE_WRITE_RIGHTS | MAKE_SOCK | MAKE_FIFO
+)
+FILE_RIGHTS = WRITE_FILE | TRUNCATE
+class Ruleset(ctypes.Structure):
+    _fields_ = [("handled_access_fs", ctypes.c_uint64)]
+class PathRule(ctypes.Structure):
+    _pack_ = 1
+    _fields_ = [
+        ("allowed_access", ctypes.c_uint64),
+        ("parent_fd", ctypes.c_int32),
+    ]
+libc = ctypes.CDLL(None, use_errno=True)
+abi = libc.syscall(CREATE, 0, 0, VERSION)
+if abi < 3:
+    raise SystemExit("Hermes mission containment requires Landlock ABI >= 3")
+attr = Ruleset(SCRATCH_WRITE_RIGHTS)
+fd = libc.syscall(CREATE, ctypes.byref(attr), ctypes.sizeof(attr), 0)
+if fd < 0:
+    err = ctypes.get_errno()
+    raise OSError(err, os.strerror(err))
+def grant(path, rights):
+    try:
+        path_fd = os.open(path, O_PATH | os.O_CLOEXEC)
+    except FileNotFoundError:
+        return False
+    try:
+        rule = PathRule(rights, path_fd)
+        if libc.syscall(ADD, fd, RULE_PATH_BENEATH, ctypes.byref(rule), 0) < 0:
+            err = ctypes.get_errno()
+            raise OSError(err, os.strerror(err), path)
+    finally:
+        os.close(path_fd)
+    return True
+for scratch in ("/tmp", "/root", "/home"):
+    grant(scratch, SCRATCH_WRITE_RIGHTS)
+grant("/dev/null", FILE_RIGHTS)
+allowed = json.loads(sys.argv[2])
+for item in allowed:
+    path = "/workspace/" + item.strip("/")
+    if os.path.isdir(path):
+        grant(path, WORKSPACE_WRITE_RIGHTS)
+    elif os.path.isfile(path):
+        grant(path, FILE_RIGHTS)
+    else:
+        # Landlock rules can only name existing filesystem objects. Missing
+        # approved paths must be created through Hermes file tools, which
+        # enforce the exact relative path before mutation.
+        continue
+if not allowed:
+    grant("/workspace", WORKSPACE_WRITE_RIGHTS)
+if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
+    err = ctypes.get_errno()
+    raise OSError(err, os.strerror(err))
+if libc.syscall(RESTRICT, fd, 0) < 0:
+    err = ctypes.get_errno()
+    raise OSError(err, os.strerror(err))
+os.close(fd)
+# Keep disposable tool state outside the repository. The container persists for
+# the task, so these paths remain reusable across sequential terminal calls.
+ephemeral = {
+    "UV_PROJECT_ENVIRONMENT": "/tmp/hermes-uv-environment",
+    "UV_CACHE_DIR": "/tmp/hermes-uv-cache",
+    "PIP_CACHE_DIR": "/tmp/hermes-pip-cache",
+    "PYTHONPYCACHEPREFIX": "/tmp/hermes-pycache",
+    "COVERAGE_FILE": "/tmp/hermes-coverage",
+    "MYPY_CACHE_DIR": "/tmp/hermes-mypy-cache",
+    "RUFF_CACHE_DIR": "/tmp/hermes-ruff-cache",
+    "XDG_CACHE_HOME": "/tmp/hermes-xdg-cache",
+    "XDG_CONFIG_HOME": "/tmp/hermes-xdg-config",
+    "XDG_DATA_HOME": "/tmp/hermes-xdg-data",
+    "npm_config_cache": "/tmp/hermes-npm-cache",
+    "YARN_CACHE_FOLDER": "/tmp/hermes-yarn-cache",
+    "CARGO_HOME": "/tmp/hermes-cargo-home",
+    "CARGO_TARGET_DIR": "/tmp/hermes-cargo-target",
+}
+for key, value in ephemeral.items():
+    os.environ.setdefault(key, value)
+pytest_options = os.environ.get("PYTEST_ADDOPTS", "").strip()
+if "no:cacheprovider" not in pytest_options:
+    os.environ["PYTEST_ADDOPTS"] = (pytest_options + " -p no:cacheprovider").strip()
+os.environ.setdefault("PYTHONDONTWRITEBYTECODE", "1")
+command = base64.b64decode(sys.argv[1]).decode("utf-8")
+os.execv("/bin/bash", ["bash", "-c", command])
+"""
+
+
+def landlock_wrapped_command(command: str, policy: dict[str, Any]) -> list[str]:
+    """Return argv for a Landlock-confined bash command inside Docker."""
+    encoded_command = base64.b64encode(command.encode("utf-8")).decode("ascii")
+    allowed_json = json.dumps(
+        list(normalized_allowed_paths(policy)), separators=(",", ":")
+    )
+    return ["python3", "-c", _LANDLOCK_LAUNCHER, encoded_command, allowed_json]
