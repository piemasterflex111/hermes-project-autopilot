+def _mission_runtime_policy(mission: mdb.Mission) -> dict[str, Any]:
+    if not mission.worktree_path:
+        raise MissionError("mission preflight requires a prepared worktree")
+    boundaries = mission.contract.boundaries
+    return {
+        "mission_id": mission.id,
+        "mission_role": "executor",
+        "worktree_path": mission.worktree_path,
+        "allowed_paths": list(boundaries.get("allowed_paths") or []),
+        "allowed_terminal_backends": list(
+            boundaries.get("allowed_terminal_backends") or ["docker"]
+        ),
+        "read_only": False,
+    }
+
+
+def _runtime_preflight(mission: mdb.Mission) -> dict[str, Any]:
+    """Production runtime probe; tests replace this function explicitly."""
+    from agent.mission_terminal_guard import runtime_preflight
+    from hermes_cli.config import load_config_readonly
+
+    config = load_config_readonly()
+    terminal = config.get("terminal") or {}
+    image = str(
+        terminal.get("docker_image")
+        or "nikolaik/python-nodejs:python3.11-nodejs20"
+    )
+    return runtime_preflight(_mission_runtime_policy(mission), image=image)
+
+
+def _record_runtime_preflight(conn, mission: mdb.Mission) -> dict[str, Any]:
+    try:
+        report = _runtime_preflight(mission)
+    except Exception as exc:
+        current = mdb.get_mission(conn, mission.id)
+        if current is not None and current.status == "planning":
+            mdb.transition_mission(
+                conn,
+                mission.id,
+                "blocked",
+                phase="planning",
+                blocked_reason=f"runtime preflight failed: {exc}",
+            )
+        raise MissionError(f"runtime preflight failed: {exc}") from exc
+    store_evidence_blob(
+        conn,
+        mission,
+        kind="preflight",
+        status="passed",
+        content=json.dumps(report, ensure_ascii=False, sort_keys=True),
+        metadata={
+            "image": report.get("image"),
+            "image_id": report.get("image_id"),
+            "host_landlock_abi": report.get("host_landlock_abi"),
+            "container_landlock_abi": report.get("container_landlock_abi"),
+            "network": report.get("network"),
+        },
+        cwd=mission.worktree_path,
+    )
+    return report
+
+
+def _validate_start_scope(mission: mdb.Mission) -> None:
+    from agent.mission_terminal_guard import verify_clean_scope
+
+    try:
+        verify_clean_scope(_mission_runtime_policy(mission))
+    except PermissionError as exc:
+        raise MissionError(f"mission scope preflight failed: {exc}") from exc
