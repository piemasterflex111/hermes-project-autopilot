+def test_mission_worker_context_embeds_bounded_json_without_board_path(
+    kanban_home, tmp_path
+):
+    from hermes_cli import missions_db as mdb
+
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    conn = kb.connect()
+    try:
+        contract = mdb.MissionContract(
+            outcome="Read contract input",
+            verification=["true"],
+            boundaries={"allowed_roots": [str(repo)], "allowed_paths": ["out"]},
+        )
+        mission_id = mdb.create_mission(
+            conn, objective="Use attached contract", contract=contract,
+            autonomy_level=3, repo_path=str(repo), board="default",
+        )
+        task_id = kb.create_task(conn, title="consume contract")
+        conn.execute(
+            "UPDATE tasks SET mission_id=?, mission_role='executor' WHERE id=?",
+            (mission_id, task_id),
+        )
+        dest_dir = kb.task_attachments_dir(task_id)
+        dest_dir.mkdir(parents=True, exist_ok=True)
+        blob = dest_dir / "contract.json"
+        blob.write_text('{"missions":["M00","M01"]}\n', encoding="utf-8")
+        kb.add_attachment(
+            conn, task_id, filename="contract.json",
+            stored_path=str(blob.resolve()), content_type="application/json",
+            size=blob.stat().st_size,
+        )
+
+        context = kb.build_worker_context(conn, task_id)
+
+        assert "embedded task input" in context
+        assert '{"missions":["M00","M01"]}' in context
+        assert str(blob.resolve()) not in context
+        assert "cannot read board-storage paths" not in context
+    finally:
+        conn.close()
+
+
+def test_mission_worker_context_does_not_advertise_binary_attachment_path(
+    kanban_home, tmp_path
+):
+    from hermes_cli import missions_db as mdb
+
+    repo = tmp_path / "repo-binary"
+    repo.mkdir()
+    conn = kb.connect()
+    try:
+        contract = mdb.MissionContract(
+            outcome="Read input", verification=["true"],
+            boundaries={"allowed_roots": [str(repo)], "allowed_paths": ["out"]},
+        )
+        mission_id = mdb.create_mission(
+            conn, objective="Use binary input", contract=contract,
+            autonomy_level=3, repo_path=str(repo), board="default",
+        )
+        task_id = kb.create_task(conn, title="consume binary")
+        conn.execute(
+            "UPDATE tasks SET mission_id=?, mission_role='executor' WHERE id=?",
+            (mission_id, task_id),
+        )
+        dest_dir = kb.task_attachments_dir(task_id)
+        dest_dir.mkdir(parents=True, exist_ok=True)
+        blob = dest_dir / "input.bin"
+        blob.write_bytes(b"\x00\x01\x02")
+        kb.add_attachment(
+            conn, task_id, filename="input.bin", stored_path=str(blob.resolve()),
+            content_type="application/octet-stream", size=3,
+        )
+
+        context = kb.build_worker_context(conn, task_id)
+
+        assert "not embedded" in context
+        assert str(blob.resolve()) not in context
+    finally:
+        conn.close()
