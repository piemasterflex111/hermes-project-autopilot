+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_controller_verification_disables_python_bytecode(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import mission_service as service
+    from hermes_cli import missions_db as mdb
+
+    hermes_home = tmp_path / "hermes-bytecode"
+    monkeypatch.setenv("HERMES_HOME", str(hermes_home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(hermes_home / "kanban"))
+    source = tmp_path / "source-bytecode"
+    source.mkdir()
+    (source / "module.py").write_text("VALUE = 1\n", encoding="utf-8")
+    _git(source, "init")
+    _git(source, "config", "user.email", "guard@example.test")
+    _git(source, "config", "user.name", "Guard Test")
+    _git(source, "add", "module.py")
+    _git(source, "commit", "-m", "base")
+    monkeypatch.setattr(service, "_configured_mission_docker_image", lambda: MISSION_IMAGE)
+
+    with kb.connect_closing(board="default") as conn:
+        contract = mdb.MissionContract(
+            outcome="Compile without cache pollution",
+            verification=[
+                "python3 -c 'import module; import pathlib; "
+                "assert not pathlib.Path(\"__pycache__\").exists()'"
+            ],
+            boundaries={
+                "allowed_roots": [str(source)],
+                "allowed_paths": ["module.py"],
+                "network_destinations": [],
+            },
+        )
+        mission_id = mdb.create_mission(
+            conn, objective="No bytecode", contract=contract,
+            autonomy_level=3, repo_path=str(source), board="default",
+        )
+        mission = service.prepare_mission(conn, mission_id)
+        results = service._run_contract_verification_commands(
+            conn, mission, list(contract.verification),
+        )
+
+    assert results[0]["exit_code"] == 0
+    assert not (Path(mission.worktree_path) / "__pycache__").exists()
