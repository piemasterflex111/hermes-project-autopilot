diff --git a/tests/hermes_cli/test_missions.py b/tests/hermes_cli/test_missions.py
index 218fcf57a..2acc608fe 100644
--- a/tests/hermes_cli/test_missions.py
+++ b/tests/hermes_cli/test_missions.py
@@ -1771,3 +1771,59 @@ def test_settle_verifier_recovers_controller_owned_triage_card(mission_env):
         "SELECT kind FROM task_events WHERE task_id=? ORDER BY id", (verifier,),
     ).fetchall()
     assert any(row["kind"] == "triage_retry_approved" for row in events)
+
+
+def test_reconcile_clears_stale_execution_lease_blocker_after_quiescence(
+    mission_env,
+):
+    conn, repo = mission_env
+    mid = _created(conn, repo, autonomy=3)
+    service.prepare_mission(conn, mid)
+    service.add_execution_task(
+        conn, mid, title="Edit app.py", body="Set VALUE", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    service.start_mission(conn, mid)
+    mdb.transition_mission(
+        conn, mid, "blocked", phase="recovery",
+        blocked_reason="terminal write denied: mission execution lease is no longer active",
+    )
+
+    reconciled = service.reconcile_mission(conn, mid)
+
+    assert reconciled.status == "blocked"
+    assert reconciled.blocked_reason is None
+    recovery = [
+        row for row in mdb.list_evidence(conn, mid)
+        if row["kind"] == "recovery"
+        and row["metadata"].get("action") == "clear_stale_execution_lease_blocker"
+    ]
+    assert recovery and recovery[-1]["status"] == "passed"
+    assert recovery[-1]["metadata"]["open_intents"] == 0
+    retried = service.retry_mission(conn, mid)
+    assert retried.status == "running"
+
+
+def test_mission_spawn_disables_python_bytecode(mission_env, monkeypatch):
+    conn, repo = mission_env
+    mid = _created(conn, repo)
+    mission = service.prepare_mission(conn, mid)
+    executor_id = service.add_execution_task(
+        conn, mid, title="Run Python", body="Run tests", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    captured = {}
+
+    class FakeProc:
+        pid = 1234
+
+    def fake_popen(cmd, *args, **kwargs):
+        captured.update(kwargs["env"])
+        return FakeProc()
+
+    monkeypatch.setattr(kb, "_resolve_hermes_argv", lambda: ["hermes"])
+    monkeypatch.setattr(service, "begin_task_intent", lambda task, board=None: None)
+    monkeypatch.setattr(subprocess, "Popen", fake_popen)
+    kb._default_spawn(kb.get_task(conn, executor_id), mission.worktree_path, board="default")
+
+    assert captured["PYTHONDONTWRITEBYTECODE"] == "1"
