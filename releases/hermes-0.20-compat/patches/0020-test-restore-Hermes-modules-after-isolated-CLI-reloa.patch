From 079a914359410009b4c23ed2a00fd807d1fe1724 Mon Sep 17 00:00:00 2001
From: Payam Adloo <31391809+piemasterflex111@users.noreply.github.com>
Date: Mon, 3 Aug 2026 20:45:55 -0700
Subject: [PATCH 20/25] test: restore Hermes modules after isolated CLI reloads

---
 .../test_kanban_cli_dispatch_passthrough.py   | 49 +++++++++++++++++--
 1 file changed, 44 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py b/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py
index 62c0eb045..bbe891f63 100644
--- a/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py
+++ b/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py
@@ -20,14 +20,53 @@ import pytest
 
 @pytest.fixture()
 def isolated_kanban_home(monkeypatch):
-    """Spin up a fresh HERMES_HOME with a clean kanban DB."""
+    """Spin up a fresh HERMES_HOME without leaking replacement modules.
+
+    The CLI tests intentionally reload the Hermes package under a temporary
+    home. Test collection may already hold references to the original module
+    objects, so leaving the replacements in ``sys.modules`` creates two
+    independent ``kanban_db`` singleton registries in the same pytest process.
+    Restore the exact original objects during teardown.
+    """
     test_home = tempfile.mkdtemp(prefix="kanban_cli_passthrough_")
     os.makedirs(os.path.join(test_home, "profiles", "default"), exist_ok=True)
     monkeypatch.setenv("HERMES_HOME", test_home)
-    for mod in list(sys.modules.keys()):
-        if mod.startswith("hermes_cli") or mod.startswith("hermes_state") or mod == "hermes_constants":
-            del sys.modules[mod]
-    yield test_home
+    selected = lambda name: (
+        name.startswith("hermes_cli")
+        or name.startswith("hermes_state")
+        or name == "hermes_constants"
+    )
+    originals = {name: module for name, module in sys.modules.items() if selected(name)}
+
+    def remove_selected_modules() -> None:
+        current = [name for name in list(sys.modules) if selected(name)]
+        # Remove child attributes before removing registry entries. Python's
+        # import machinery writes ``package.child`` separately from
+        # ``sys.modules["package.child"]``.
+        for name in sorted(current, key=lambda value: value.count("."), reverse=True):
+            if "." in name:
+                parent_name, child_name = name.rsplit(".", 1)
+                parent = sys.modules.get(parent_name)
+                if parent is not None and getattr(parent, child_name, None) is sys.modules.get(name):
+                    delattr(parent, child_name)
+            sys.modules.pop(name, None)
+
+    def restore_original_modules() -> None:
+        sys.modules.update(originals)
+        for name, module in sorted(originals.items(), key=lambda item: item[0].count(".")):
+            if "." not in name:
+                continue
+            parent_name, child_name = name.rsplit(".", 1)
+            parent = sys.modules.get(parent_name)
+            if parent is not None:
+                setattr(parent, child_name, module)
+
+    remove_selected_modules()
+    try:
+        yield test_home
+    finally:
+        remove_selected_modules()
+        restore_original_modules()
 
 
 def test_cli_dispatch_passes_max_in_progress_from_config(isolated_kanban_home, monkeypatch):
