+def test_controller_runs_missing_exact_verification_before_model(
+    mission_env, monkeypatch
+):
+    conn, repo = mission_env
+    mid = _created(conn, repo, autonomy=3)
+    mission = service.prepare_mission(conn, mid)
+    executor = service.add_execution_task(
+        conn, mid, title="Edit app.py", body="Set VALUE", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    service.start_mission(conn, mid)
+    worktree = Path(mission.worktree_path)
+    (worktree / "app.py").write_text("VALUE = 3\n")
+    assert kb.complete_task(conn, executor, result="implemented", summary="implemented")
+    observed = []
+
+    def exact_runner(run_conn, run_mission, commands):
+        observed.append(list(commands))
+        for command in commands:
+            service.record_command_result(
+                run_conn,
+                run_mission.id,
+                command=command,
+                cwd=str(worktree),
+                exit_code=0,
+                stdout="passed",
+                containment={
+                    "controller_verification": True,
+                    "workspace_mount": "read-only",
+                    "network": "none",
+                },
+            )
+        return [{"command": command, "exit_code": 0} for command in commands]
+
+    monkeypatch.setattr(service, "_run_contract_verification_commands", exact_runner)
+    monkeypatch.setattr(
+        "agent.auxiliary_client.call_llm",
+        lambda **kwargs: _passing_verifier_response(),
+    )
+
+    waiting = service.verify_with_model(conn, mid)
+
+    assert observed == [["verify-ok"]]
+    assert waiting.status == "awaiting_approval"
+    exact = [
+        row for row in mdb.list_evidence(conn, mid)
+        if row["kind"] == "command" and row["command"] == "verify-ok"
+    ]
+    assert exact and exact[-1]["status"] == "passed"
+    assert exact[-1]["metadata"]["containment"]["controller_verification"] is True
+
+
+def test_failed_exact_verification_skips_model(mission_env, monkeypatch):
+    conn, repo = mission_env
+    mid = _created(conn, repo, autonomy=3)
+    mission = service.prepare_mission(conn, mid)
+    executor = service.add_execution_task(
+        conn, mid, title="Edit app.py", body="Set VALUE", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    service.start_mission(conn, mid)
+    worktree = Path(mission.worktree_path)
+    (worktree / "app.py").write_text("VALUE = 3\n")
+    assert kb.complete_task(conn, executor, result="implemented", summary="implemented")
+    model_calls = []
+
+    def failing_runner(run_conn, run_mission, commands):
+        for command in commands:
+            service.record_command_result(
+                run_conn,
+                run_mission.id,
+                command=command,
+                cwd=str(worktree),
+                exit_code=1,
+                stdout="verification failed",
+                containment={
+                    "controller_verification": True,
+                    "workspace_mount": "read-only",
+                    "network": "none",
+                },
+            )
+        return [{"command": command, "exit_code": 1} for command in commands]
+
+    def model_must_not_run(**kwargs):
+        model_calls.append(kwargs)
+        raise AssertionError("semantic model ran after deterministic failure")
+
+    monkeypatch.setattr(service, "_run_contract_verification_commands", failing_runner)
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", model_must_not_run)
+
+    blocked = service.verify_with_model(conn, mid)
+
+    assert blocked.status == "blocked"
+    assert blocked.phase == "verification"
+    assert model_calls == []
+    independent = [
+        row for row in mdb.list_evidence(conn, mid)
+        if row["kind"] == "independent_verifier"
+    ]
+    assert independent and independent[-1]["status"] == "failed"
