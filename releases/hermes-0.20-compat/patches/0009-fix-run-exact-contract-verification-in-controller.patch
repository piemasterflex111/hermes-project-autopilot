+@REQUIRES_LOCAL_MISSION_IMAGE
+def test_controller_runs_exact_verification_in_read_only_container(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import mission_service as service
+    from hermes_cli import missions_db as mdb
+
+    hermes_home = tmp_path / "hermes-controller"
+    monkeypatch.setenv("HERMES_HOME", str(hermes_home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(hermes_home / "kanban"))
+    source = tmp_path / "controller-source"
+    source.mkdir()
+    source.chmod(0o755)
+    (source / "app.py").write_text("VALUE = 1\n", encoding="utf-8")
+    _git(source, "init")
+    _git(source, "config", "user.email", "guard@example.test")
+    _git(source, "config", "user.name", "Guard Test")
+    _git(source, "add", "app.py")
+    _git(source, "commit", "-m", "base")
+    monkeypatch.setattr(
+        service,
+        "_configured_mission_docker_image",
+        lambda: MISSION_IMAGE,
+    )
+
+    with kb.connect_closing(board="default") as conn:
+        contract = mdb.MissionContract(
+            outcome="Update app.py",
+            verification=["python3 -m py_compile app.py"],
+            constraints=["Verification is read-only"],
+            boundaries={
+                "allowed_roots": [str(source)],
+                "allowed_paths": ["app.py"],
+                "network_destinations": [],
+            },
+        )
+        mission_id = mdb.create_mission(
+            conn,
+            objective="Prove controller verification isolation",
+            contract=contract,
+            autonomy_level=3,
+            repo_path=str(source),
+            board="default",
+        )
+        mission = service.prepare_mission(conn, mission_id)
+        worktree = Path(str(mission.worktree_path))
+        worktree.chmod(0o755)
+        (worktree / "app.py").write_text("VALUE = 2\n", encoding="utf-8")
+
+        results = service._run_contract_verification_commands(
+            conn,
+            mission,
+            ["python3 -m py_compile app.py"],
+        )
+        evidence = mdb.list_evidence(conn, mission_id)
+
+    assert results == [
+        {
+            "command": "python3 -m py_compile app.py",
+            "exit_code": 0,
+            "evidence_id": results[0]["evidence_id"],
+        }
+    ]
+    exact = [row for row in evidence if row["kind"] == "command"]
+    assert exact and exact[-1]["command"] == "python3 -m py_compile app.py"
+    assert exact[-1]["exit_code"] == 0
+    assert exact[-1]["metadata"]["containment"]["workspace_mount"] == "read-only"
+    assert exact[-1]["metadata"]["containment"]["network"] == "none"
+    assert not (worktree / "__pycache__").exists()
+    assert not (worktree / ".pytest_cache").exists()
+    assert not (worktree / ".coverage").exists()
+    assert _git(worktree, "status", "--porcelain") == "M app.py"
