+def _run_contract_verification_commands(
+    conn,
+    mission: mdb.Mission,
+    commands: list[str],
+) -> list[dict[str, Any]]:
+    """Run exact contract commands in a read-only offline mission container."""
+    if not commands:
+        return []
+    if not mission.worktree_path:
+        raise MissionError("verification requires a prepared mission worktree")
+    from agent.mission_terminal_guard import (
+        canonicalize_command,
+        landlock_wrapped_command,
+        verify_clean_scope,
+    )
+    from tools.environments.docker import find_docker
+
+    policy = _mission_runtime_policy(mission) | {"read_only": True}
+    verify_clean_scope(policy)
+    docker = find_docker()
+    if not docker:
+        raise MissionError("verification requires the Docker executable")
+    image = _configured_mission_docker_image()
+    root = Path(mission.worktree_path).resolve(strict=True)
+    results: list[dict[str, Any]] = []
+    for criterion in commands:
+        executed = canonicalize_command(criterion, policy)
+        argv = landlock_wrapped_command(
+            executed,
+            policy,
+            read_only_workspace=True,
+        )
+        started_at = int(time.time())
+        proc = subprocess.run(
+            [
+                docker,
+                "run",
+                "--rm",
+                "--network=none",
+                "--cap-drop=ALL",
+                "--security-opt=no-new-privileges",
+                "-v",
+                f"{root}:/workspace:ro",
+                "-w",
+                "/workspace",
+                image,
+                *argv,
+            ],
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=300,
+            check=False,
+            stdin=subprocess.DEVNULL,
+        )
+        finished_at = int(time.time())
+        containment = {
+            "controller_verification": True,
+            "network": "none",
+            "workspace_mount": "read-only",
+            "image": image,
+            "executed_command_sha256": hashlib.sha256(
+                executed.encode("utf-8")
+            ).hexdigest(),
+        }
+        evidence_id = record_command_result(
+            conn,
+            mission.id,
+            command=criterion,
+            cwd=str(root),
+            exit_code=int(proc.returncode),
+            stdout=proc.stdout,
+            started_at=started_at,
+            finished_at=finished_at,
+            containment=containment,
+        )
+        results.append(
+            {
+                "command": criterion,
+                "exit_code": int(proc.returncode),
+                "evidence_id": evidence_id,
+            }
+        )
+    verify_clean_scope(policy)
+    return results
+
+
+def _deterministic_failure_verdict(
+    mission: mdb.Mission,
+    report: dict[str, Any],
+) -> dict[str, Any]:
+    failed: list[str] = []
+    failed.extend(str(item) for item in report.get("missing_verification", []))
+    failed.extend(
+        f"scope violation: {item}" for item in report.get("scope_violations", [])
+    )
+    failed.extend(
+        f"unsupported path: {item}" for item in report.get("unsupported_paths", [])
+    )
+    if report.get("open_intent_count"):
+        failed.append("unresolved mutation intent")
+    if not report.get("evidence_chain_valid"):
+        failed.append("invalid evidence chain")
+    if not report.get("head_unchanged"):
+        failed.append("mission branch HEAD changed before controller commit")
+    if not report.get("changed_paths"):
+        failed.append("empty repository diff")
+    return {
+        "verdict": "fail",
+        "requirements_checked": max(1, len(mission.contract.verification)),
+        "requirements_failed": failed or ["deterministic verification failed"],
+        "evidence_missing": list(report.get("missing_verification", [])),
+        "recommended_action": "replan",
+    }
+
