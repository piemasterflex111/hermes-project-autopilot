+++ b/tests/hermes_cli/test_mission_scale.py
@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def _load_benchmark():
+    path = Path(__file__).parents[2] / "scripts" / "benchmark_project_autopilot_scale.py"
+    spec = importlib.util.spec_from_file_location("autopilot_scale_benchmark", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_bounded_multi_mission_scale_smoke():
+    benchmark = _load_benchmark()
+    result = benchmark.run_benchmark(
+        mission_count=6,
+        tasks_per_mission=4,
+        workers=8,
+        evidence_per_mission=3,
+    )
+    assert result["pass"] is True
+    assert result["executor_tasks"] == 24
+    assert result["duplicate_claim_winners"] == 1
+    assert result["sqlite_integrity"] == "ok"
+    assert result["open_runs"] == 0
+
+
+def test_scale_harness_rejects_unbounded_single_mission():
+    benchmark = _load_benchmark()
+    try:
+        benchmark.run_benchmark(
+            mission_count=1,
+            tasks_per_mission=13,
+            workers=1,
+            evidence_per_mission=0,
+        )
+    except ValueError as exc:
+        assert "between 1 and 12" in str(exc)
+    else:
+        raise AssertionError("unbounded mission should be rejected")
