diff --git a/tests/hermes_cli/test_missions.py b/tests/hermes_cli/test_missions.py
index e14036bd8..454414adf 100644
--- a/tests/hermes_cli/test_missions.py
+++ b/tests/hermes_cli/test_missions.py
@@ -1483,6 +1483,51 @@ def test_execution_retry_requeues_blocked_executor_via_controller(mission_env):
     assert any(row["kind"] == "unblocked" for row in events)
 
 
+def test_execution_retry_explicitly_requeues_triage_executor(mission_env):
+    conn, repo = mission_env
+    mid = _created(conn, repo, autonomy=3)
+    service.prepare_mission(conn, mid)
+    executor = service.add_execution_task(
+        conn, mid, title="Needs repaired capability", body="Edit app.py", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    service.start_mission(conn, mid)
+
+    assert kb.block_task(
+        conn, executor, reason="missing approved capability", kind="capability",
+    )
+    service.controller_tick(conn)
+    assert mdb.get_mission(conn, mid).status == "blocked"
+    first_retry = service.retry_mission(conn, mid)
+    assert first_retry.status == "running"
+    assert kb.get_task(conn, executor).status == "ready"
+
+    assert kb.block_task(
+        conn, executor, reason="missing approved capability", kind="capability",
+    )
+    service.controller_tick(conn)
+    escalated = kb.get_task(conn, executor)
+    assert escalated.status == "triage"
+    assert escalated.block_recurrences == 2
+    assert mdb.get_mission(conn, mid).status == "blocked"
+
+    retried = service.retry_mission(conn, mid)
+
+    assert retried.status == "running"
+    task = kb.get_task(conn, executor)
+    assert task.status == "ready"
+    assert task.block_kind == "capability"
+    assert task.block_recurrences == 2
+    events = conn.execute(
+        "SELECT kind, payload FROM task_events WHERE task_id=? ORDER BY id",
+        (executor,),
+    ).fetchall()
+    assert any(row["kind"] == "triage_retry_approved" for row in events)
+    evidence = mdb.list_evidence(conn, mid)
+    retry = next(row for row in reversed(evidence) if row["metadata"].get("action") == "retry")
+    assert retry["metadata"]["retried_tasks"] == [executor]
+
+
 def test_mission_report_exposes_durable_task_graph(mission_env):
     conn, repo = mission_env
     mid = _created(conn, repo)
