diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 9aaebcc73..3679ac5f1 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -6115,6 +6115,81 @@ def unblock_task(conn: sqlite3.Connection, task_id: str) -> bool:
         return True
 
 
+def retry_triage_task(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    actor: str,
+    reason: Optional[str] = None,
+) -> bool:
+    """Approve one explicit retry of a task escalated to ``triage``.
+
+    This is intentionally narrower than the generic Kanban status controls.
+    Mission-linked task cards may call it only while holding
+    :func:`_trusted_mission_controller_mutation`.  Parent dependencies are
+    re-evaluated before the task returns to ``ready``/``todo``.  The original
+    ``block_kind`` and ``block_recurrences`` are preserved so the same
+    unresolved failure immediately escalates back to triage rather than
+    entering an infinite retry loop.
+    """
+    assert_task_mutation_allowed(conn, task_id, operation="retry triage")
+    if not actor or not actor.strip():
+        raise ValueError("actor is required")
+    now = int(time.time())
+    with write_txn(conn):
+        row = conn.execute(
+            "SELECT current_run_id, block_kind, block_recurrences "
+            "FROM tasks WHERE id = ? AND status = 'triage'",
+            (task_id,),
+        ).fetchone()
+        if row is None:
+            return False
+        if row["current_run_id"]:
+            conn.execute(
+                """
+                UPDATE task_runs
+                   SET status = 'reclaimed', outcome = 'reclaimed',
+                       summary = COALESCE(summary, 'invariant recovery on triage retry'),
+                       ended_at = ?, claim_lock = NULL, claim_expires = NULL,
+                       worker_pid = NULL
+                 WHERE id = ? AND ended_at IS NULL
+                """,
+                (now, int(row["current_run_id"])),
+            )
+        undone_parent = conn.execute(
+            "SELECT 1 FROM task_links l "
+            "JOIN tasks p ON p.id = l.parent_id "
+            "WHERE l.child_id = ? AND p.status != 'done' LIMIT 1",
+            (task_id,),
+        ).fetchone()
+        new_status = "todo" if undone_parent else "ready"
+        cur = conn.execute(
+            """
+            UPDATE tasks
+               SET status = ?, current_run_id = NULL,
+                   consecutive_failures = 0, last_failure_error = NULL,
+                   claim_lock = NULL, claim_expires = NULL, worker_pid = NULL
+             WHERE id = ? AND status = 'triage'
+            """,
+            (new_status, task_id),
+        )
+        if cur.rowcount != 1:
+            return False
+        _append_event(
+            conn,
+            task_id,
+            "triage_retry_approved",
+            {
+                "actor": actor.strip(),
+                "reason": reason,
+                "status": new_status,
+                "block_kind": row["block_kind"],
+                "block_recurrences": int(row["block_recurrences"] or 0),
+            },
+        )
+    return True
+
+
 def specify_triage_task(
     conn: sqlite3.Connection,
     task_id: str,
