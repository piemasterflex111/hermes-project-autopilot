diff --git a/tools/file_operations.py b/tools/file_operations.py
index f6a2deaca..fefa60270 100644
--- a/tools/file_operations.py
+++ b/tools/file_operations.py
@@ -1019,6 +1019,24 @@ class ShellFileOperations(FileOperations):
         q_path = self._escape_shell_arg(path)
         parent = os.path.dirname(path) or "."
         q_parent = self._escape_shell_arg(parent)
+
+        # Mission workers may receive write authority for one exact existing
+        # file without write authority for its parent directory.  A sibling
+        # temp file would therefore be outside the compiled Landlock policy,
+        # even though the requested target itself is approved.  File-tool
+        # callers have already passed the exact target through
+        # mission_scope.require_write_path, and Landlock still enforces the
+        # final path.  In mission mode write the approved target in place and
+        # rely on the mission checkpoint/rollback boundary for crash recovery
+        # rather than widening parent-directory permissions.
+        if os.environ.get("HERMES_MISSION_POLICY", "").strip():
+            script = (
+                "set -e; "
+                f"t={q_path}; "
+                'cat > "$t"'
+            )
+            return self._exec(script, stdin_data=content)
+
         # template basename: hidden so it doesn't show up in casual `ls`,
         # carries a marker so an orphaned temp (only possible on a hard
         # crash *between* cat and mv) is identifiable.
