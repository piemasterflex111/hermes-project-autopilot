+def clear_blocked_reason(
+    conn: sqlite3.Connection,
+    mission_id: str,
+    *,
+    expected_reason: Optional[str] = None,
+) -> Mission:
+    """Clear a stale blocker while keeping the mission durably blocked.
+
+    This is intentionally narrower than a lifecycle transition.  It is used
+    after reconciliation proves that an earlier ambiguous mutation no longer
+    has an open intent or live owner.  The operator must still invoke the
+    normal retry action to resume execution.
+    """
+    ensure_schema(conn)
+    with kb.write_txn(conn):
+        row = conn.execute(
+            "SELECT status,blocked_reason FROM missions WHERE id=?", (mission_id,),
+        ).fetchone()
+        if row is None:
+            raise KeyError(mission_id)
+        if row["status"] != "blocked":
+            raise ValueError("blocked reason can only be cleared for a blocked mission")
+        if expected_reason is not None and row["blocked_reason"] != expected_reason:
+            raise ValueError("blocked reason changed before reconciliation completed")
+        conn.execute(
+            "UPDATE missions SET blocked_reason=NULL, updated_at=? WHERE id=? AND status='blocked'",
+            (int(time.time()), mission_id),
+        )
+    mission = get_mission(conn, mission_id)
+    assert mission is not None
+    return mission
+
