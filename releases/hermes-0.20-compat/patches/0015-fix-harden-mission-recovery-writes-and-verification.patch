+def test_reconcile_clears_stale_ambiguous_blocker_after_quiescence(
+    mission_env,
+):
+    conn, repo = mission_env
+    mid = _created(conn, repo, autonomy=3)
+    service.prepare_mission(conn, mid)
+    service.add_execution_task(
+        conn, mid, title="Edit app.py", body="Set VALUE", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    service.start_mission(conn, mid)
+    mdb.transition_mission(
+        conn,
+        mid,
+        "blocked",
+        phase="recovery",
+        blocked_reason="recovery_ambiguous: unresolved mutation intent",
+    )
+
+    reconciled = service.reconcile_mission(conn, mid)
+
+    assert reconciled.status == "blocked"
+    assert reconciled.blocked_reason is None
+    recovery = [
+        row for row in mdb.list_evidence(conn, mid)
+        if row["kind"] == "recovery"
+        and row["metadata"].get("action") == "clear_stale_ambiguous_blocker"
+    ]
+    assert recovery and recovery[-1]["status"] == "passed"
+    retried = service.retry_mission(conn, mid)
+    assert retried.status == "running"
+
