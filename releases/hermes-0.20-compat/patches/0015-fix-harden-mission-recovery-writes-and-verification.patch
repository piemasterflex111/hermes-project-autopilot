diff --git a/tests/tools/test_file_write_safety.py b/tests/tools/test_file_write_safety.py
index d59dce7b2..bf5bce032 100644
--- a/tests/tools/test_file_write_safety.py
+++ b/tests/tools/test_file_write_safety.py
@@ -257,6 +257,27 @@ class TestAtomicWrite:
         assert (os.stat(target).st_mode & 0o777) == 0o600
 
 
+    def test_mission_exact_file_write_does_not_create_sibling_temp(
+        self, ops, tmp_path: Path, monkeypatch,
+    ):
+        """Exact-file Landlock grants cannot authorize a sibling temp file.
+
+        Mission writes therefore target the already-approved file directly;
+        normal non-mission writes retain atomic rename semantics.
+        """
+        target = tmp_path / ".gitignore"
+        target.write_text("old\n")
+        inode_before = target.stat().st_ino
+        monkeypatch.setenv("HERMES_MISSION_POLICY", '{"mission_id":"m_test"}')
+
+        result = ops.write_file(str(target), "new\n")
+
+        assert result.error is None, result.error
+        assert target.read_text() == "new\n"
+        assert target.stat().st_ino == inode_before
+        assert not list(tmp_path.glob(".hermes-tmp*"))
+
