+def test_settle_verifier_recovers_controller_owned_triage_card(mission_env):
+    conn, repo = mission_env
+    mid = _created(conn, repo, autonomy=3)
+    service.prepare_mission(conn, mid)
+    service.add_execution_task(
+        conn, mid, title="Edit app.py", body="Set VALUE", assignee="default",
+    )
+    service.finish_plan(conn, mid, verifier_assignee="default")
+    verifier = conn.execute(
+        "SELECT id FROM tasks WHERE mission_id=? AND mission_role='verifier'",
+        (mid,),
+    ).fetchone()["id"]
+
+    with kb._trusted_mission_controller_mutation():
+        promoted, reason = kb.promote_task(
+            conn, verifier, actor="test", reason="prepare verifier", force=True,
+        )
+    assert promoted, reason
+    assert kb.block_task(conn, verifier, reason="first failure", kind="needs_input")
+    with kb._trusted_mission_controller_mutation():
+        assert kb.unblock_task(conn, verifier)
+        promoted, reason = kb.promote_task(
+            conn, verifier, actor="test", reason="second verifier attempt", force=True,
+        )
+    assert promoted, reason
+    assert kb.block_task(conn, verifier, reason="same failure", kind="needs_input")
+    assert kb.get_task(conn, verifier).status == "triage"
+
+    service._settle_verifier_task(
+        conn, mid, passed=True, reason="Acceptance criteria passed.",
+    )
+
+    settled = kb.get_task(conn, verifier)
+    assert settled is not None
+    assert settled.status == "done"
+    assert settled.block_recurrences == 0
+    events = conn.execute(
+        "SELECT kind FROM task_events WHERE task_id=? ORDER BY id", (verifier,),
+    ).fetchall()
+    assert any(row["kind"] == "triage_retry_approved" for row in events)
