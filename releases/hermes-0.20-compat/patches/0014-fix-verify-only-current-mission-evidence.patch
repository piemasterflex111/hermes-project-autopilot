+            return
+        task = kb.get_task(conn, task_id)
+    if task is not None and task.status not in {"ready", "running"}:
         with kb._trusted_mission_controller_mutation():
             promoted, _ = kb.promote_task(
                 conn, task_id, actor="mission-controller",
