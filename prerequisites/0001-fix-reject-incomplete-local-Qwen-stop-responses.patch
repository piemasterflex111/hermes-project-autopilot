diff --git a/agent/conversation_loop.py b/agent/conversation_loop.py
index 3ca96898c..0b0d30c1e 100644
--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -2639,11 +2639,104 @@ def run_conversation(
                     _finish_result = _cc_fr.normalize_response(response)
                     finish_reason = _finish_result.finish_reason
                     assistant_message = _finish_result
-                    if agent._should_treat_stop_as_truncated(
+                    _stop_anomaly = agent._classify_suspicious_stop_response(
                         finish_reason,
                         assistant_message,
                         messages,
-                    ):
+                    )
+                    if _stop_anomaly == "local_qwen_incomplete_stop":
+                        _stop_provider_data = (
+                            getattr(assistant_message, "provider_data", None) or {}
+                        )
+                        from agent.redact import redact_sensitive_text
+
+                        _stop_preview = redact_sensitive_text(
+                            (getattr(assistant_message, "content", None) or "")[-240:],
+                            force=True,
+                        )
+                        if agent._incomplete_stop_retries < 1:
+                            agent._incomplete_stop_retries += 1
+                            logger.warning(
+                                "Rejected suspicious local Qwen stop; retrying once "
+                                "without persisting partial text "
+                                "(stop_reason=%r last_token_id=%r chunks=%r preview=%r)",
+                                _stop_provider_data.get("stop_reason"),
+                                _stop_provider_data.get("last_token_id"),
+                                _stop_provider_data.get("stream_chunk_count"),
+                                _stop_preview,
+                            )
+                            if agent.tool_progress_callback:
+                                try:
+                                    agent.tool_progress_callback(
+                                        "message.reset",
+                                        None,
+                                        None,
+                                        None,
+                                        reason="incomplete_stop_retry",
+                                    )
+                                except Exception:
+                                    logger.debug(
+                                        "Failed to emit message.reset for incomplete-stop retry",
+                                        exc_info=True,
+                                    )
+                            agent._emit_status(
+                                "↻ Local model stopped mid-response — retrying once "
+                                "with a fresh connection."
+                            )
+                            agent._close_cached_request_openai_client(
+                                reason="incomplete_stop_retry"
+                            )
+                            continue
+
+                        logger.error(
+                            "Local Qwen returned a second suspicious stop; "
+                            "rejecting partial output "
+                            "(stop_reason=%r last_token_id=%r chunks=%r preview=%r)",
+                            _stop_provider_data.get("stop_reason"),
+                            _stop_provider_data.get("last_token_id"),
+                            _stop_provider_data.get("stream_chunk_count"),
+                            _stop_preview,
+                        )
+                        if agent._has_pending_fallback():
+                            agent._buffer_status(
+                                "⚠️ Local model stopped mid-response twice — "
+                                "switching to fallback..."
+                            )
+                        if agent._try_activate_fallback():
+                            active_system_prompt = _sync_failover_system_message(
+                                agent, api_messages, active_system_prompt
+                            )
+                            agent._incomplete_stop_retries = 0
+                            retry_count = 0
+                            compression_attempts = 0
+                            _retry.primary_recovery_attempted = False
+                            continue
+
+                        _failure_text = (
+                            "⚠️ Hermes rejected two incomplete local-model "
+                            "responses. The partial text was not saved or used "
+                            "as conversation history. Retry in a fresh turn or "
+                            "configure a fallback model."
+                        )
+                        messages.append(
+                            {
+                                "role": "assistant",
+                                "content": _failure_text,
+                                "finish_reason": "incomplete_stop_rejected",
+                                "_provider_failure_sentinel": True,
+                            }
+                        )
+                        agent._cleanup_task_resources(effective_task_id)
+                        agent._persist_session(messages, conversation_history)
+                        return {
+                            "final_response": _failure_text,
+                            "messages": messages,
+                            "api_calls": api_call_count,
+                            "completed": False,
+                            "partial": True,
+                            "error": "repeated_incomplete_stop",
+                        }
+                    elif _stop_anomaly == "ollama_glm_stop_misreport":
                         agent._vprint(
                             f"{agent.log_prefix}⚠️  Treating suspicious Ollama/GLM stop response as truncated",
                             force=True,
