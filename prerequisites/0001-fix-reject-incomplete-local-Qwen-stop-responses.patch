@@ -0,0 +1,274 @@
+"""Regression coverage for explicit ``stop`` responses that end mid-sentence.
+
+The live failure this pins was a local Qwen/vLLM completion persisted as a
+normal stop even though it ended with ``Step 2. Now let me build th``.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+
+def _assistant(content: str, tool_calls=None):
+    return SimpleNamespace(content=content, tool_calls=tool_calls)
+
+
+def _response(
+    content: str,
+    *,
+    finish_reason: str = "stop",
+    stop_reason=None,
+    token_ids=None,
+    chunk_count=None,
+):
+    choice = SimpleNamespace(
+        message=_assistant(content),
+        finish_reason=finish_reason,
+        stop_reason=stop_reason,
+        token_ids=token_ids,
+    )
+    response = SimpleNamespace(
+        choices=[choice],
+        model="qwen3.6-35b-a3b-nvfp4-multimodal",
+        usage=None,
+    )
+    if chunk_count is not None:
+        response._stream_chunk_count = chunk_count
+    return response
+
+
+def _local_agent():
+    from run_agent import AIAgent
+
+    with (
+        patch("run_agent.get_tool_definitions", return_value=[]),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="http://127.0.0.1:8003/v1",
+            model="qwen3.6-35b-a3b-nvfp4-multimodal",
+            provider="custom",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+    agent.client = MagicMock()
+    agent.api_mode = "chat_completions"
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    return agent
+
+
+class TestIncompleteStopClassifier:
+    @pytest.mark.parametrize(
+        "text",
+        [
+            "Step 2. Now let me build th",
+            "I will now create the",
+            "Next step: let me run the",
+            "```python\nprint('unfinished')",
+        ],
+    )
+    def test_strong_local_qwen_incomplete_shapes_are_rejected(self, text):
+        agent = _local_agent()
+        reason = agent._classify_suspicious_stop_response(
+            "stop", _assistant(text), []
+        )
+        assert reason == "local_qwen_incomplete_stop"
+
+    @pytest.mark.parametrize(
+        "text",
+        [
+            "C",
+            "Done.",
+            "Phase 1",
+            "/home/payam-adloo/Work",
+            "The selected model is qwen3.6-35b-a3b-nvfp4-multimodal",
+            "I checked the repository and found no uncommitted changes",
+        ],
+    )
+    def test_valid_short_or_unpunctuated_answers_are_not_rejected(self, text):
+        agent = _local_agent()
+        assert (
+            agent._classify_suspicious_stop_response(
+                "stop", _assistant(text), []
+            )
+            is None
+        )
+
+    def test_remote_qwen_is_not_subject_to_local_recovery_heuristic(self):
+        agent = _local_agent()
+        agent.base_url = "https://example.com/v1"
+        reason = agent._classify_suspicious_stop_response(
+            "stop", _assistant("Step 2. Now let me build th"), []
+        )
+        assert reason is None
+
+    def test_tool_call_response_is_never_reclassified(self):
+        agent = _local_agent()
+        reason = agent._classify_suspicious_stop_response(
+            "stop",
+            _assistant(
+                "Step 2. Now let me build th",
+                tool_calls=[SimpleNamespace(id="call_1")],
+            ),
+            [],
+        )
+        assert reason is None
+
+    def test_existing_ollama_glm_detector_contract_is_preserved(self):
+        agent = _local_agent()
+        agent.model = "glm-5.1"
+        agent.provider = "ollama"
+        agent.base_url = "http://127.0.0.1:11434/v1"
+        reason = agent._classify_suspicious_stop_response(
+            "stop",
+            _assistant("I inspected the tool result and will continue with the"),
+            [{"role": "tool", "content": "ok"}],
+        )
+        assert reason == "ollama_glm_stop_misreport"
+        assert agent._should_treat_stop_as_truncated(
+            "stop",
+            _assistant("I inspected the tool result and will continue with the"),
+            [{"role": "tool", "content": "ok"}],
+        )
+
+
+class TestStreamingTerminationTelemetry:
+    @patch("run_agent.AIAgent._create_request_openai_client")
+    @patch("run_agent.AIAgent._close_request_openai_client")
+    def test_stream_preserves_vllm_stop_reason_token_ids_and_chunk_count(
+        self, _mock_close, mock_create
+    ):
+        agent = _local_agent()
+
+        def chunk(content=None, finish_reason=None, stop_reason=None, token_ids=None):
+            delta = SimpleNamespace(
+                content=content,
+                tool_calls=None,
+                reasoning_content=None,
+                reasoning=None,
+            )
+            choice = SimpleNamespace(
+                index=0,
+                delta=delta,
+                finish_reason=finish_reason,
+                stop_reason=stop_reason,
+                token_ids=token_ids,
+            )
+            return SimpleNamespace(choices=[choice], model="qwen-local", usage=None)
+
+        mock_client = MagicMock()
+        mock_client.chat.completions.create.return_value = iter(
+            [
+                chunk(content="Complete answer."),
+                chunk(finish_reason="stop", stop_reason=151643, token_ids=[10, 20]),
+            ]
+        )
+        mock_create.return_value = mock_client
+
+        response = agent._interruptible_streaming_api_call({})
+        choice = response.choices[0]
+        assert choice.finish_reason == "stop"
+        assert choice.stop_reason == 151643
+        assert choice.token_ids == [20]
+        assert response._stream_chunk_count == 2
+
+        normalized = agent._get_transport().normalize_response(response)
+        assert normalized.provider_data == {
+            "stop_reason": 151643,
+            "last_token_id": 20,
+            "stream_chunk_count": 2,
+        }
+
+        hook_payload = agent._api_response_payload_for_hook(
+            response, normalized, finish_reason=normalized.finish_reason
+        )
+        assert hook_payload["provider_data"]["stop_reason"] == 151643
+        assert hook_payload["stream"]["chunk_count"] == 2
+
+
+class TestConversationRecovery:
+    def _run(self, agent, responses):
+        agent.client.chat.completions.create.side_effect = responses
+        agent.tool_progress_callback = MagicMock()
+        with (
+            patch.object(agent, "_persist_session"),
+            patch.object(agent, "_save_trajectory"),
+            patch.object(agent, "_cleanup_task_resources"),
+            patch.object(agent, "_close_cached_request_openai_client") as close_cache,
+        ):
+            result = agent.run_conversation("Build the OMSCS bridge")
+        return result, close_cache
+
+    def test_first_bad_stop_retries_fresh_without_replaying_partial_text(self):
+        agent = _local_agent()
+        bad = _response(
+            "Phase 1 complete. Step 2. Now let me build th",
+            stop_reason=151643,
+            token_ids=[1, 2],
+            chunk_count=9,
+        )
+        good = _response("Phase 1 is complete. The verified artifacts are ready.")
+
+        result, close_cache = self._run(agent, [bad, good])
+
+        assert agent.client.chat.completions.create.call_count == 2
+        close_cache.assert_called_once_with(reason="incomplete_stop_retry")
+        agent.tool_progress_callback.assert_any_call(
+            "message.reset",
+            None,
+            None,
+            None,
+            reason="incomplete_stop_retry",
+        )
+        assert result["completed"] is True
+        assert result["final_response"] == good.choices[0].message.content
+        assert all(
+            "Now let me build th" not in (m.get("content") or "")
+            for m in result["messages"]
+            if isinstance(m, dict)
+        )
+
+        second = agent.client.chat.completions.create.call_args_list[1]
+        sent = second.kwargs.get("messages") or second.args[0].get("messages")
+        assert all(
+            "Now let me build th" not in (m.get("content") or "")
+            for m in sent
+            if isinstance(m, dict)
+        )
+
+    def test_second_bad_stop_fails_closed_without_persisting_bad_text(self):
+        agent = _local_agent()
+        bad1 = _response("Phase 1. Step 2. Now let me build th")
+        bad2 = _response("Retrying now. Let me create the")
+
+        result, close_cache = self._run(agent, [bad1, bad2])
+
+        assert agent.client.chat.completions.create.call_count == 2
+        close_cache.assert_called_once_with(reason="incomplete_stop_retry")
+        agent.tool_progress_callback.assert_any_call(
+            "message.reset",
+            None,
+            None,
+            None,
+            reason="incomplete_stop_retry",
+        )
+        assert result["completed"] is False
+        assert result["partial"] is True
+        assert result["error"] == "repeated_incomplete_stop"
+        assert "rejected two incomplete" in result["final_response"]
+        assert all(
+            "Now let me build th" not in (m.get("content") or "")
+            and "Let me create the" not in (m.get("content") or "")
+            for m in result["messages"]
+            if isinstance(m, dict)
+        )
+        assert result["messages"][-1]["_provider_failure_sentinel"] is True
