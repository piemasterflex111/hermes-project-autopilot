+"""Presentation-control regression tests for incomplete-stop retries."""
+
+from pathlib import Path
+from unittest.mock import MagicMock
+
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+
+def test_runs_api_forwards_message_reset_control_event():
+    adapter = APIServerAdapter(PlatformConfig(enabled=True))
+    run_id = "run-reset"
+    queue = MagicMock()
+    adapter._run_streams[run_id] = queue
+
+    loop = MagicMock()
+    loop.call_soon_threadsafe.side_effect = lambda fn, value: fn(value)
+    callback = adapter._make_run_event_callback(run_id, loop)
+
+    callback("message.reset", reason="incomplete_stop_retry")
+
+    event = queue.put_nowait.call_args.args[0]
+    assert event["event"] == "message.reset"
+    assert event["run_id"] == run_id
+    assert event["reason"] == "incomplete_stop_retry"
+
+
+def test_chat_completion_sse_defines_non_persistent_reset_event():
+    source = (
+        Path(__file__).resolve().parents[2]
+        / "gateway"
+        / "platforms"
+        / "api_server.py"
+    ).read_text(encoding="utf-8")
+
+    assert 'tool_progress_callback=_on_stream_control' in source
+    assert '("__stream_reset__", {' in source
+    assert 'event: hermes.message.reset' in source
+    assert 'elif isinstance(item, tuple) and len(item) == 2 and item[0] == "__stream_reset__"' in source
