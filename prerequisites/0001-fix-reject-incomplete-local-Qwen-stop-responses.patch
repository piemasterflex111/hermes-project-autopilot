diff --git a/run_agent.py b/run_agent.py
index a240bb292..cbdcc4593 100644
--- a/run_agent.py
+++ b/run_agent.py
@@ -1648,36 +1648,114 @@ class AIAgent:
             return True
         return provider_lower == "ollama"
 
-    def _should_treat_stop_as_truncated(
+    @staticmethod
+    def _looks_like_incomplete_stop_text(content: str) -> bool:
+        """Return True only for strong evidence that ``stop`` ended mid-response.
+
+        This deliberately avoids a broad "missing punctuation means truncated"
+        rule. Valid answers can be headings, identifiers, paths, or one-word
+        replies. The detector fires only for structural breakage (an unclosed
+        code fence) or an execution-intent tail ending in a connector or tiny
+        word fragment, such as ``Step 2. Now let me build th``.
+        """
+        if not isinstance(content, str):
+            return False
+        stripped = content.rstrip()
+        if len(stripped) < 20 or not re.search(r"\s", stripped):
+            return False
+        if stripped.count("```") % 2:
+            return True
+        if AIAgent._has_natural_response_ending(stripped):
+            return False
+
+        tail = stripped[-360:].lower()
+        intent = re.search(
+            r"(?:\b(?:now\s+)?let\s+me\b|\bi(?:'ll| will)\b|"
+            r"\bnext(?:\s+step)?\b|\bstep\s+\d+\b)",
+            tail,
+        )
+        if not intent:
+            return False
+
